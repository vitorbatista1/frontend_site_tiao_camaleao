---
import { Image } from "astro:assets";
import relogio from "../../../public/imagens/campanha2/relogio.png";
import WhatsAppSellerButton from "../WhatsAppSellerButton.astro";
---

<!-- EDIÇÃO ESPECIAL - RESPONSIVO -->
<section
  id="novo-album3"
  class="relative flex items-center justify-center pb-12 md:pb-20 mt-8 md:mt-16 section-compact"
  style="background-color: #FFE8C4;"
>
  <div class="benefits-bg absolute inset-0 pointer-events-none"></div>
  <div class="container max-w-6xl mx-auto px-2 md:px-4">
    <div class="flex justify-center">
      <div class="w-full max-w-6xl md:max-w-3xl relative">

        <!-- Título sobreposto -->
        <div class="flex justify-center absolute -top-7 left-0 right-0 z-10">
          <div class="bg-[#FF8C00] py-2 px-4 md:px-8 rounded-full inline-block shadow-lg">
            <h3
              class="text-center leading-normal whitespace-nowrap"
              style="font-size: clamp(20px, 2vw, 36px); font-weight: 800; color: #ffffff;"
            >
              Edição Especial de Lançamento!
            </h3>
          </div>
        </div>

        <!-- Card -->
        <div class="bg-white rounded-2xl shadow-lg flex flex-col items-center p-3 sm:p-8 text-center pt-12 sm:pt-14">
          <div class="w-full flex flex-col items-center justify-center gap-2 mt-4">
            <h3
              class="leading-snug text-center"
              style="font-size: clamp(42px, 3.5vw, 42px); font-weight: 800; color: #1171D3;"
            >
              NOVO ÁLBUM 3
            </h3>
            <p
              class="text-center"
              style="font-size: clamp(32px, 3vw, 30px); font-weight: 400; color: #1171D3; max-width: 95%;"
            >
              por apenas
            </p>
            <p
              class="text-center"
              style="font-size: clamp(55px, 4vw, 54px); font-weight: 800; color: red;"
            >
              R$ 67
            </p>
          </div>

          <!-- Lista centralizada -->
          <div class="w-full flex flex-col items-start gap-3 mt-4 px-2 md:px-4">
            <div class="flex items-start gap-3 text-left" style="font-size: clamp(18px, 2.4vw, 24px); font-weight: 400; color: #1171D3;">
              <svg class="flex-shrink-0 mt-0.5" width="22" height="22" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <circle cx="12" cy="12" r="12" fill="#22C55E"/>
                <path d="M7 12L10.5 15.5L17.5 8.5" stroke="white" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
              <span><span class="font-bold">10 cantigas personalizadas</span>, sendo:</span>
            </div>
            <div class="flex items-start gap-3 text-left" style="font-size: clamp(18px, 2.4vw, 24px); font-weight: 400; color: #1171D3;">
              <svg class="flex-shrink-0 mt-0.5" width="22" height="22" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <circle cx="12" cy="12" r="12" fill="#22C55E"/>
                <path d="M7 12L10.5 15.5L17.5 8.5" stroke="white" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
              <span><span class="font-bold">7 cantigas clássicas</span></span>
            </div>
            <div class="flex items-start gap-3 text-left" style="font-size: clamp(18px, 2.4vw, 24px); font-weight: 400; color: #1171D3;">
              <svg class="flex-shrink-0 mt-0.5" width="22" height="22" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <circle cx="12" cy="12" r="12" fill="#22C55E"/>
                <path d="M7 12L10.5 15.5L17.5 8.5" stroke="white" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
              <span><span class="font-bold">3 cantigas autorais e inéditas</span></span>
            </div>
          </div>

<!-- Relógios -->
<div class="w-full flex flex-col items-center mt-8 md:mt-12 px-2 md:px-4">

  <!-- Linha dos relógios -->
  <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
    <div class="flex-shrink-0">
      <Image
        src={relogio}
        alt="Relógio"
        widths={[96, 144, 192, 384]}
        sizes="(max-width: 768px) 96px, (max-width: 1024px) 144px, 192px"
        quality={75}
        format="webp"
        class="w-24 md:w-36 lg:w-48 h-auto object-contain"
        loading="lazy"
      />
    </div>

    <div class="text-center leading-tight">
      <h2
        class="font-bold text-red-600"
        style="font-size: clamp(25px, 2vw, 26px);"
      >
        Edição de lançamento limitada<br />
        às 200 primeiras compras.
      </h2>
    </div>

    <div class="flex-shrink-0">
      <Image
        src={relogio}
        alt="Relógio"
        widths={[96, 144, 192, 384]}
        sizes="(max-width: 768px) 96px, (max-width: 1024px) 144px, 192px"
        quality={75}
        format="webp"
        class="w-24 md:w-36 lg:w-48 h-auto object-contain"
        loading="lazy"
      />
    </div>
  </div>

  <!-- Texto separado -->
  <p
    class="text-center font-normal text-red-600 mt-4"
    style="font-size: clamp(20px, 1.6vw, 21px);"
  >
    Entrega do 1º lote:<br />
    primeira semana de agosto.
  </p>

</div>

          <!-- Botão COMPRAR AGORA -->
          <div class="cta-group w-full justify-center mt-6 md:mt-8">
            <a
              href="#produtos"
              class="btn-red-rounded"
              data-buy
              data-buy-name="Álbum 3"
              data-buy-price="R$ 67,00"
              data-buy-campaign="campanha2"
              style="display: inline-flex; align-items: center; gap: 0.75rem; background: #E63946; color: white; font-weight: 700; font-size: clamp(25px, 2vw, 20px); padding: 0.6rem 1.8rem; border-radius: 9999px; text-decoration: none; transition: 0.2s; box-shadow: 0 4px 10px rgba(230, 57, 70, 0.3);"
              onmouseover="this.style.backgroundColor='#c1121f'"
              onmouseout="this.style.backgroundColor='#E63946'"
            >
              COMPRAR AGORA
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 md:h-5 md:w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="9" cy="21" r="1"></circle>
                <circle cx="20" cy="21" r="1"></circle>
                <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
              </svg>
            </a>
            <WhatsAppSellerButton
              style="display: inline-flex; align-items: center; gap: 0.75rem; background: #25D366; color: white; font-weight: 700; font-size: clamp(25px, 2vw, 20px); padding: 0.6rem 1.8rem; border-radius: 9999px; text-decoration: none; transition: 0.2s; box-shadow: 0 2px 6px rgba(37, 211, 102, 0.25);"
              onmouseover="this.style.backgroundColor='#1EBE5B'"
              onmouseout="this.style.backgroundColor='#25D366'"
            />
          </div>

          <!-- Card laranja -->
          <div class="w-full mt-6 md:mt-8">
            <div class="bg-[#FF8C00] rounded-2xl py-6 px-4 md:px-6 shadow-md flex flex-col items-center">
              <svg class="w-16 h-16 md:w-20 md:h-20 mb-1" viewBox="0 0 24 24" fill="white" xmlns="http://www.w3.org/2000/svg">
                <path d="M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2Z" stroke="white" stroke-width="1.5" stroke-linejoin="round"/>
              </svg>
              <h3
                class="text-center font-bold"
                style="font-size: clamp(16px, 1.8vw, 45px); color: #ffffff; letter-spacing: 0.5px;"
              >
                Pré-venda exclusiva
              </h3>

              <ul class="mt-4 text-left text-white" style="font-size: clamp(20px, 1.3vw, 25px); font-weight: 400; line-height: 1.8; list-style-type: disc; padding-left: 20px;">
                <li>Estamos abrindo <b>200 vagas de gravação</b> para clientes que já conhecem nosso trabalho, antes do lançamento oficial ao público geral.</li>
                <li>A entrega deste primeiro lote está programada para a <b>primeira semana de agosto</b> - depois disso, novos pedidos entram em fila de produção.</li>
                <li>Depois do lançamento os nomes que ainda não estiverem gravados terão custo adicional de estúdio.</li>
                <li>E as novas gravações poderão entrar em fila de produção e demorar para entregar.</li>
                <li>Por isso, essa é a melhor oportunidade para garantir o Álbum 3.</li>
              </ul>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>