---
import iconeTiao from "../../../public/imagens/campanha2/icone_tiao.png";
---

<!-- BENEFITS - RESPONSIVO -->
<section
  class="relative pt-8 pb-16 md:pt-10 md:pb-20"
  style="background-color: #ffffff;"
>
  <div class="benefits-bg absolute inset-0 pointer-events-none"></div>
  <div class="container px-4">
    <div class="text-center mb-8 md:mb-16">
      <div class="w-full flex justify-center">
        <img
          src={iconeTiao.src}
          alt="Balões decorativos"
          class="w-full max-w-[80px] md:max-w-[120px] h-auto object-contain"
        />
      </div>
      <h2 class="mt-2 leading-tight" style="font-size: clamp(28px, 5vw, 65px); font-weight: 800; color: #1171D3;">
        O álbum mais completo<br> que já fizemos
      </h2>
    </div>

    <div class="w-full grid grid-cols-1 md:grid-cols-2 gap-4 md:gap-6 max-w-6xl mx-auto">

      <!-- CARD 1 -->
      <div class="bg-white rounded-2xl shadow-lg flex flex-col items-center p-4 sm:p-5 text-center">
        <div class="w-full flex flex-col items-center justify-center gap-2">
          <h3
            class="leading-snug text-center"
            style="font-size: clamp(22px, 3vw, 38px); font-weight: 800; color: #1171D3;"
          >
            100% das cantigas<br />personalizadas
          </h3>
          <p
            class="text-center"
            style="font-size: clamp(16px, 2vw, 24px); font-weight: 400; color: #1171D3; max-width: 95%;"
          >
            Dessa vez, todas as músicas<br />cantam o nome da criança.
          </p>
        </div>
      </div>

      <!-- CARD 2 -->
      <div class="bg-white rounded-2xl shadow-lg flex flex-col items-center p-6 sm:p-5 text-center">
        <div class="w-full flex flex-col items-center justify-center gap-2">
          <h3
            class="leading-snug text-center"
            style="font-size: clamp(22px, 3vw, 38px); font-weight: 800; color: #1171D3;"
          >
            Clássicos que<br />atravessam gerações
          </h3>
          <p
            class="text-center"
            style="font-size: clamp(16px, 2vw, 24px); font-weight: 400; color: #1171D3; max-width: 95%;"
          >
            As cantigas que pais, mães e avós<br />conhecem, agora personalizadas.
          </p>
        </div>
      </div>
    </div>

    <!-- CARD 3 - EXCLUSIVO DESTA PRÉ-VENDA -->
    <div class="w-full flex justify-center mt-6 md:mt-12 px-2 sm:px-8">
      <div class="bg-[#1171D3] rounded-2xl shadow-lg flex flex-col items-center p-4 sm:p-12 md:p-20 text-center max-w-4xl w-full">
        <div class="w-full flex flex-col items-center justify-center gap-3">
          <div class="bg-[#FF8C00] rounded-full py-2 px-4 sm:px-8 md:px-8 inline-block -mt-6 md:mt-0">
            <h3
              class="text-center leading-normal"
              style="font-size: clamp(19px, 2.5vw, 34px); font-weight: 800; color: #ffffff; white-space: nowrap;"
            >
              EXCLUSIVO DESTA PRÉ-VENDA
            </h3>
          </div>

          <h4
            class="leading-snug text-center"
            style="font-size: clamp(22px, 2.2vw, 45px); font-weight: 700; color: #ffffff;"
          >
            3 músicas autorais inéditas
          </h4>
          <p
            style="font-size: clamp(19px, 1.5vw, 35px); font-weight: 400; color: #ffffff;"
          >
            Lançamento de 3 músicas criadas especialmente<br class="hidden sm:block" />
            para o universo do Tião Camaleão.
          </p>
        </div>
      </div>
    </div>
  </div>
</section>