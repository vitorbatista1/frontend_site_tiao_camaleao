---
// [TC-CAPI 2026-06] ID via env (centralizado), com fallback para o dataset unificado
const META_PIXEL_ID = import.meta.env.PUBLIC_META_PIXEL_ID ?? "2321147791624359";
const TIKTOK_PIXEL_ID = import.meta.env.PUBLIC_TIKTOK_PIXEL_ID ?? "";
const META_TEST_EVENT_CODE = import.meta.env.PUBLIC_META_TEST_EVENT_CODE ?? "";
---

<!-- Loader compartilhado (Meta/GA/Contentsquare): dispara o script pesado na
     PRIMEIRA interação real do usuário (scroll/toque/mouse/tecla) — ou depois
     de um tempo maior de ociosidade, para quem não interage. Isso tira a
     execução desses scripts da janela FCP→TTI que o Lighthouse usa pra medir
     TBT, sem perder eventos (os stubs/filas de cada lib já enfileiram tudo
     enquanto o script real não chega). -->
<script is:inline>
  function _tcDeferLoad(fn){
    var done = false;
    function go(){ if (done) return; done = true; fn(); }
    ['scroll','keydown','mousemove','touchstart','click'].forEach(function(ev){
      window.addEventListener(ev, go, { passive: true, once: true });
    });
    'requestIdleCallback' in window
      ? requestIdleCallback(go, { timeout: 6000 })
      : window.addEventListener('load', function(){ setTimeout(go, 500); });
  }
</script>

<!-- Meta Pixel: init imediato (garante que fica primeiro na fila antes de qualquer evento),
     fbevents.js (251 KB) só carrega no gatilho acima, para não brigar com o TBT -->
<script is:inline define:vars={{ META_PIXEL_ID, META_TEST_EVENT_CODE }}>
  !function(){
    var n=window.fbq=function(){n.callMethod?n.callMethod.apply(n,arguments):n.queue.push(arguments)};
    if(!window._fbq)window._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';n.queue=[];
  }();
  // init entra na fila ANTES de qualquer evento de interação do usuário
  fbq('init', META_PIXEL_ID);
  // expõe o test_event_code para uso nos eventos de tracking (só preenchido em ambiente de teste)
  window._fbTestEventCode = META_TEST_EVENT_CODE || null;
  _tcDeferLoad(function(){
    var t=document.createElement('script');t.async=!0;
    t.src='https://connect.facebook.net/en_US/fbevents.js';
    document.head.appendChild(t);
    fbq('track','PageView');
  });
</script>
<noscript>
  <img height="1" width="1" style="display:none"
    src={`https://www.facebook.com/tr?id=${META_PIXEL_ID}&ev=PageView&noscript=1`} />
</noscript>

<!-- TikTok Pixel — só carrega se PUBLIC_TIKTOK_PIXEL_ID estiver definido -->
{TIKTOK_PIXEL_ID && (
  <script is:inline define:vars={{ TIKTOK_PIXEL_ID }}>
    _tcDeferLoad(function () {
      !function (w, d, t) {
        w.TiktokAnalyticsObject=t;var ttq=w[t]=w[t]||[];ttq.methods=["page","track","identify","instances","debug","on","off","once","ready","alias","group","enableCookie","disableCookie","holdConsent","revokeConsent","grantConsent"],ttq.setAndDefer=function(t,e){t[e]=function(){t.push([e].concat(Array.prototype.slice.call(arguments,0)))}};for(var i=0;i<ttq.methods.length;i++)ttq.setAndDefer(ttq,ttq.methods[i]);ttq.instance=function(t){for(var e=ttq._i[t]||[],n=0;n<ttq.methods.length;n++)ttq.setAndDefer(e,ttq.methods[n]);return e},ttq.load=function(e,n){var r="https://analytics.tiktok.com/i18n/pixel/events.js",o=n&&n.partner;ttq._i=ttq._i||{},ttq._i[e]=[],ttq._i[e]._u=r,ttq._t=ttq._t||{},ttq._t[e]=+new Date,ttq._o=ttq._o||{},ttq._o[e]=n||{};n=document.createElement("script");n.type="text/javascript",n.async=!0,n.src=r+"?sdkid="+e+"&lib="+t;e=document.getElementsByTagName("script")[0];e.parentNode.insertBefore(n,e)};
        ttq.load(TIKTOK_PIXEL_ID);
        ttq.page();
      }(window, document, 'ttq');
    });
  </script>
)}
