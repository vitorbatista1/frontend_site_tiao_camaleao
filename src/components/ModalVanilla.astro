---
const API_URL = import.meta.env.PUBLIC_API_URL ?? "";
---

<div
  id="tc-modal"
  data-api={API_URL}
  class="fixed inset-0 z-50 flex items-center justify-center p-4"
  style="display:none"
  role="dialog"
  aria-modal="true"
>
  <div id="tc-backdrop" class="absolute inset-0 bg-black/60"></div>
  <div class="relative max-w-md w-full bg-white rounded-3xl shadow-2xl max-h-[90vh] flex flex-col">
    <div id="tc-header" class="sticky top-0 bg-white border-b border-gray-100 p-6 rounded-t-3xl z-10"></div>
    <div id="tc-body" class="px-6 pb-6 overflow-y-auto flex-1 min-h-0"></div>
    <div class="sticky bottom-0 border-t border-gray-100 p-6 bg-gray-50 rounded-b-3xl">
      <button id="tc-next-btn" class="w-full bg-primary hover:bg-primary/90 text-white font-bold py-4 px-6 rounded-2xl transition-all flex items-center justify-center gap-3 shadow-lg">
        <span id="tc-next-lbl">Continuar</span>
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
      </button>
    </div>
  </div>
</div>

<script is:inline>
(function () {
  var API = document.getElementById("tc-modal").dataset.api;

  // ── Estado ──────────────────────────────────────────────────────────────────
  var isOpen = false, step = 1;
  var customer = { fullName: "", email: "", telefone: "" };
  var children = [];
  var albumsAPI = [];
  var loadingAlbums = false;
  var albumErrors = {};
  var errors = { fullName: "", email: "", telefone: "" };
  var productName = "";
  var isCombo = false;

  var COMBO_GRAVADO_PRICE_FULL = 150;
  var COMBO_GRAVADO_ONE_MISSING = 120;

  // ── Helpers de álbum ─────────────────────────────────────────────────────────
  function getAlbumsOnly() { return albumsAPI.filter(function(a){ return a.tipo === "ALBUM"; }); }
  function getCombo() { return albumsAPI.find(function(a){ return a.tipo === "COMBO"; }); }
  function getGravacao() { return albumsAPI.filter(function(a){ return a.tipo === "GRAVACAO"; }); }
  function getGravacaoIndividuais() { return getGravacao().slice(0, getAlbumsOnly().length); }
  function getGravacaoIds() { return getGravacao().map(function(a){ return a.id; }); }
  function isComboGravadoSelected(sel) {
    var ids = getGravacaoIds();
    return ids.length >= 2 && ids.every(function(id){ return sel.indexOf(id) >= 0; });
  }

  function getAlbumByKey(key) {
    return getAlbumsOnly()[parseInt(key.replace("album_", "")) - 1];
  }
  function getAlbumById(id) { return albumsAPI.find(function(a){ return a.id === id; }); }
  function getAlbumLabel(id) { var a = getAlbumById(id); return a ? a.name : id; }

  function priceOf(keyOrId) {
    var a = keyOrId.startsWith("album_") ? getAlbumByKey(keyOrId) : getAlbumById(keyOrId);
    return parseFloat((a && a.priceNew) || "0");
  }
  function priceOldOf(keyOrId) {
    var a = keyOrId.startsWith("album_") ? getAlbumByKey(keyOrId) : getAlbumById(keyOrId);
    return parseFloat((a && a.priceOld) || "0");
  }
  function calcSubtotal(sel, foundAlbumsCount) {
    if (isComboGravadoSelected(sel)) {
      var gravIds = getGravacaoIds();
      var extras = sel.filter(function(id){ return gravIds.indexOf(id) < 0; });
      var comboPrice = (foundAlbumsCount >= 1) ? COMBO_GRAVADO_ONE_MISSING : COMBO_GRAVADO_PRICE_FULL;
      return comboPrice + extras.reduce(function(s,k){ return s + priceOf(k); }, 0);
    }
    return sel.reduce(function(s,k){ return s + priceOf(k); }, 0);
  }
  function calcTotal() {
    return children.reduce(function(t, c) {
      var sel = c.selectedAlbums || [];
      var foundCount = (c.albumResult && c.albumResult.found) ? (c.albumResult.albums || []).length : 0;
      return t + calcSubtotal(sel, foundCount);
    }, 0).toFixed(2);
  }

  // ── DOM ──────────────────────────────────────────────────────────────────────
  function $header() { return document.getElementById("tc-header"); }
  function $body()   { return document.getElementById("tc-body"); }
  function $nextLbl(){ return document.getElementById("tc-next-lbl"); }

  function esc(s) {
    return String(s == null ? "" : s)
      .replace(/&/g,"&amp;").replace(/</g,"&lt;")
      .replace(/>/g,"&gt;").replace(/"/g,"&quot;");
  }

  // ── Header ────────────────────────────────────────────────────────────────────
  function renderHeader() {
    $header().innerHTML =
      '<div class="flex justify-between items-start">' +
        '<div>' +
          '<h2 class="text-2xl font-bold text-gray-800">' + (step===1?"Pré-checkout":"Dados das Crianças") + '</h2>' +
          '<p class="text-sm text-gray-500 mt-1">' + (step===1?"Informe seus dados para continuar":"Adicione o nome das crianças") + '</p>' +
        '</div>' +
        '<button id="tc-close" class="p-2 hover:bg-gray-100 rounded-full transition-colors">' +
          '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-gray-500"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>' +
        '</button>' +
      '</div>' +
      '<div class="flex gap-2 mt-6">' +
        '<div class="flex-1 h-1 rounded-full bg-primary"></div>' +
        '<div class="flex-1 h-1 rounded-full transition-all ' + (step>=2?"bg-primary":"bg-gray-200") + '"></div>' +
      '</div>';
    document.getElementById("tc-close").onclick = function(){ step===1 ? closeModal() : goStep(1); };
  }

  // ── Step 1 ────────────────────────────────────────────────────────────────────
  function renderStep1() {
    function field(id, type, ph, val, err) {
      return '<div><input id="'+id+'" type="'+type+'" placeholder="'+ph+'" value="'+esc(val)+'"' +
        ' class="w-full px-4 py-3 border-2 rounded-xl focus:outline-none transition-colors ' +
        (err ? "border-red-500" : "border-gray-200 focus:border-primary") + '" />' +
        (err ? '<p class="text-red-500 text-xs mt-1">'+esc(err)+'</p>' : '') + '</div>';
    }
    $body().innerHTML =
      '<div class="space-y-4 pt-4"><div class="space-y-3">' +
        field("tc-name",  "text",  "Nome completo *",       customer.fullName,  errors.fullName) +
        field("tc-email", "email", "Seu melhor e-mail *",   customer.email,     errors.email) +
        field("tc-phone", "text",  "(DDD) 9XXXX-XXXX *",   customer.telefone,  errors.telefone) +
      '</div><div class="bg-amber-50 rounded-xl p-3 border border-amber-200">' +
        '<p class="text-xs text-amber-800">⚠️ <strong>Campos obrigatórios:</strong> Nome completo, E-mail e Telefone</p>' +
      '</div></div>';

    document.getElementById("tc-name").addEventListener("input", function(e){
      customer.fullName = e.target.value;
      if (errors.fullName) { errors.fullName = ""; renderStep1(); }
    });
    document.getElementById("tc-email").addEventListener("input", function(e){
      customer.email = e.target.value;
      if (errors.email) { errors.email = ""; renderStep1(); }
    });
    document.getElementById("tc-phone").addEventListener("input", function(e){
      var input = e.target;
      var n = input.value.replace(/\D/g, "").slice(0, 11);
      var fmt = n.length <= 10
        ? n.replace(/^(\d{0,2})(\d{0,4})(\d{0,4})$/, function(_,a,b,c){ return (a?"("+a:"") + (b?") "+b:"") + (c?"-"+c:""); })
        : n.replace(/^(\d{0,2})(\d{0,5})(\d{0,4})$/, function(_,a,b,c){ return (a?"("+a:"") + (b?") "+b:"") + (c?"-"+c:""); });
      customer.telefone = fmt;
      input.value = fmt;
      if (errors.telefone) { errors.telefone = ""; renderStep1(); }
    });
  }

  // ── Toggle combo gravado ──────────────────────────────────────────────────────
  function toggleComboGravado(childId) {
    var gravIds = getGravacaoIds();
    children = children.map(function(c){
      if (c.id !== childId) return c;
      var sel = c.selectedAlbums || [];
      var ativo = isComboGravadoSelected(sel);
      var semGrav = sel.filter(function(id){ return gravIds.indexOf(id) < 0; });
      return Object.assign({}, c, { selectedAlbums: ativo ? semGrav : semGrav.concat(gravIds) });
    });
    albumErrors[childId] = "";
    renderStep2();
  }

  // ── SVG check ─────────────────────────────────────────────────────────────────
  var CHECK = '<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>';

  function comboGravadoBtn(childId, ativo, price) {
    var cls = ativo ? "border-orange-500 bg-orange-50" : "border-dashed border-orange-400 hover:bg-orange-50";
    var dotCls = ativo ? "border-orange-500 bg-orange-500" : "border-orange-400";
    return '<button type="button" class="tc-combo-grav w-full flex items-center justify-between px-4 py-3 rounded-xl border-2 transition-all '+cls+'" data-cid="'+childId+'">' +
      '<div class="flex items-center gap-2">' +
        '<div class="w-5 h-5 rounded-full border-2 flex items-center justify-center flex-shrink-0 '+dotCls+'">'+(ativo?CHECK:'')+'</div>' +
        '<div class="text-left">' +
          '<span class="text-sm font-bold text-orange-700 block">🎁 Combo Gravado</span>' +
          '<span class="text-xs text-orange-600">Os 2 álbuns gravados — melhor custo-benefício!</span>' +
        '</div>' +
      '</div>' +
      '<span class="text-sm font-bold text-orange-700 ml-2 flex-shrink-0">R$ '+price.toFixed(2).replace(".",",")+'</span>' +
    '</button>';
  }

  function albumBtn(childId, key, selected, disabled, label, pNew, pOld, selCls, unselCls, checkCls, green) {
    var disAttr = disabled ? " disabled" : "";
    var wrapCls = disabled
      ? "border-gray-100 bg-gray-50 opacity-50 cursor-not-allowed"
      : selected ? selCls : unselCls;
    var dotCls = selected ? checkCls : "border-gray-300";
    var textCls = green ? "text-green-700 font-bold" : "";
    var priceCls = green ? "text-green-700" : "text-gray-700";
    var strikeColor = green ? "text-green-500" : "text-gray-400";
    return (
      '<button type="button"'+disAttr+' class="tc-album w-full flex items-center justify-between px-4 py-3 rounded-xl border-2 transition-all '+wrapCls+'" data-cid="'+childId+'" data-key="'+key+'">' +
        '<div class="flex items-center gap-2">' +
          '<div class="w-5 h-5 rounded-full border-2 flex items-center justify-center flex-shrink-0 '+dotCls+'">'+(selected?CHECK:'')+'</div>' +
          '<span class="text-sm font-medium text-left '+textCls+'">'+esc(label)+'</span>' +
        '</div>' +
        '<div class="text-right flex-shrink-0 ml-2">' +
          (pOld>pNew?'<span class="text-xs '+strikeColor+' line-through block">R$ '+pOld.toFixed(2).replace(".",",")+'</span>':'') +
          '<span class="text-sm font-bold '+priceCls+'">R$ '+pNew.toFixed(2).replace(".",",")+'</span>' +
        '</div>' +
      '</button>'
    );
  }

  function buildFoundAlbums(child) {
    var combo = getCombo();
    var sel = child.selectedAlbums || [];
    var comboId = combo ? combo.id : "combo";
    var comboSel = sel.indexOf(comboId) >= 0;
    var comboGravSel = isComboGravadoSelected(sel);

    // álbuns digitais já gravados (disponíveis para compra)
    var btns = (child.albumResult.albums || []).map(function(albumId){
      var a = getAlbumById(albumId);
      var isSelected = sel.indexOf(albumId) >= 0;
      return albumBtn(child.id, albumId, isSelected && !comboGravSel, comboSel || comboGravSel,
        a ? a.name : getAlbumLabel(albumId),
        parseFloat((a && a.priceNew) || "0"),
        parseFloat((a && a.priceOld) || "0"),
        "border-primary bg-primary/5", "border-gray-200 hover:border-primary/50 hover:bg-gray-50",
        "border-primary bg-primary", false);
    }).join("");

    // combo digital (verde) — só se tiver 2+ álbuns gravados
    var comboBtn = "";
    if ((child.albumResult.albums||[]).length >= 2 && combo) {
      var cs = sel.indexOf(combo.id) >= 0;
      comboBtn = albumBtn(child.id, "combo", cs, false,
        "🎁 "+combo.name, parseFloat(combo.priceNew), parseFloat(combo.priceOld),
        "border-green-500 bg-green-50", "border-dashed border-green-400 hover:bg-green-50",
        "border-green-500 bg-green-500", true);
    }

    // seção de gravação para álbuns faltantes
    var gravSection = "";
    var albumsOnly = getAlbumsOnly();
    var childAlbumIds = child.albumResult.albums || [];
    var missing = albumsOnly.filter(function(a){ return childAlbumIds.indexOf(a.id) < 0; });
    var gravacaoAlbums = getGravacao();
    var gravIndividuais = getGravacaoIndividuais();

    if (missing.length > 0 && gravacaoAlbums.length > 0) {
      if (missing.length >= 2) {
        gravSection =
          '<div class="space-y-1 pt-1">' +
            '<p class="text-xs font-semibold text-orange-600 px-1">🎙️ Grave os 2 álbuns com o nome de '+esc(child.albumResult.display_name||child.name)+':</p>' +
            comboGravadoBtn(child.id, comboGravSel, COMBO_GRAVADO_PRICE_FULL) +
          '</div>';
      } else {
        var missingIndex = albumsOnly.findIndex(function(a){ return a.id === missing[0].id; });
        var gravOffer = gravIndividuais[missingIndex];
        var gravBtnHtml = "";
        if (gravOffer) {
          var gravSel = sel.indexOf(gravOffer.id) >= 0;
          gravBtnHtml = albumBtn(child.id, gravOffer.id, gravSel && !comboGravSel, comboGravSel,
            "🎙️ "+gravOffer.name,
            parseFloat(gravOffer.priceNew),
            parseFloat(gravOffer.priceOld || "0"),
            "border-orange-500 bg-orange-50", "border-dashed border-orange-400 hover:bg-orange-50",
            "border-orange-500 bg-orange-500", false);
        }
        gravSection =
          '<div class="space-y-1 pt-1">' +
            '<p class="text-xs font-semibold text-orange-600 px-1">🎙️ Disponível em versão gravada:</p>' +
            gravBtnHtml +
            comboGravadoBtn(child.id, comboGravSel, COMBO_GRAVADO_ONE_MISSING) +
          '</div>';
      }
    }

    return '<div class="space-y-2">' +
      '<p class="text-xs font-semibold text-gray-600 px-1">Álbuns disponíveis para <span class="text-primary">'+esc(child.albumResult.display_name||child.name)+'</span>:</p>' +
      '<div class="space-y-2">'+btns+comboBtn+'</div>' +
      gravSection +
    '</div>';
  }

  function buildNotFound(child) {
    var grav = getGravacao();
    var gravIndiv = getGravacaoIndividuais();
    var albumsOnly = getAlbumsOnly();
    var sel = child.selectedAlbums || [];
    var comboGravSel = isComboGravadoSelected(sel);

    var btns = gravIndiv.map(function(a){
      var isSel = sel.indexOf(a.id) >= 0;
      return albumBtn(child.id, a.id, isSel && !comboGravSel, comboGravSel,
        "🎙️ "+a.name, parseFloat(a.priceNew), parseFloat(a.priceOld || "0"),
        "border-orange-500 bg-orange-50", "border-dashed border-orange-400 hover:bg-orange-50",
        "border-orange-500 bg-orange-500", false);
    }).join("");

    var comboBtn = (albumsOnly.length >= 2 && grav.length > 0)
      ? comboGravadoBtn(child.id, comboGravSel, COMBO_GRAVADO_PRICE_FULL)
      : "";

    return '<div class="space-y-2">' +
      '<div class="px-3 py-2 bg-amber-50 border border-amber-200 rounded-xl">' +
        '<p class="text-xs text-amber-700">⚠️ Nenhum álbum encontrado para <strong>"'+esc(child.name)+'"</strong>. '+
          (grav.length===0?"Será feito sob encomenda.":"")+'</p>' +
      '</div>' +
      (grav.length>0?
        '<div class="space-y-1">' +
          '<p class="text-xs font-semibold text-orange-600 px-1">🎙️ Grave os álbuns com o nome de <strong>'+esc(child.name)+'</strong>:</p>' +
          btns + comboBtn +
        '</div>'
      :'') +
    '</div>';
  }

  function buildSummary() {
    var rows = children.map(function(c){
      var sel = c.selectedAlbums || [];
      if (!c.name || !sel.length) return "";
      var foundCount = (c.albumResult && c.albumResult.found) ? (c.albumResult.albums || []).length : 0;
      var sub = calcSubtotal(sel, foundCount);
      var labels = isComboGravadoSelected(sel)
        ? ["Combo Gravado"]
        : sel.map(function(k){ return esc(getAlbumLabel(k)); });
      return '<div class="flex justify-between text-xs text-gray-600">' +
        '<span>'+esc(c.albumResult&&c.albumResult.display_name||c.name)+' — '+labels.join(" + ")+'</span>' +
        '<span class="font-semibold">R$ '+sub.toFixed(2).replace(".",",")+'</span></div>';
    }).join("");
    if (!rows) return "";
    return '<div class="bg-gray-50 rounded-xl p-4 border border-gray-200 space-y-2">' +
      '<p class="text-sm font-semibold text-gray-700">Resumo:</p>'+rows+
      '<div class="border-t border-gray-300 pt-2 flex justify-between font-bold text-gray-800">' +
        '<span>Total</span><span>R$ '+calcTotal().replace(".",",")+'</span></div></div>';
  }

  function resultAreaHtml(child) {
    if (child.isSearching) {
      return '<div class="flex items-center gap-2 px-3 py-2 bg-gray-50 rounded-xl border border-gray-200">' +
        '<div class="w-4 h-4 border-2 border-primary border-t-transparent rounded-full animate-spin"></div>' +
        '<span class="text-xs text-gray-500">Buscando álbuns...</span></div>';
    }
    if (child.albumResult && child.albumResult.found) return buildFoundAlbums(child);
    if (child.albumResult && !child.albumResult.found && child.name.trim().length >= 2) return buildNotFound(child);
    return "";
  }

  // ── Step 2 ────────────────────────────────────────────────────────────────────
  function renderStep2() {
    var hasSel = children.some(function(c){ return (c.selectedAlbums||[]).length > 0; });
    var cards = children.map(function(c, idx){
      return '<div class="space-y-2" data-cid="'+c.id+'">' +
        '<div class="flex gap-2 items-center">' +
          '<input type="text" placeholder="Nome da criança '+(idx+1)+' *" value="'+esc(c.name)+'"' +
            ' class="tc-child-name flex-1 px-4 py-3 border-2 border-gray-200 rounded-xl focus:border-primary focus:outline-none transition-colors"' +
            ' data-id="'+c.id+'" />' +
          '<button class="tc-rm-child p-3 text-red-500 hover:bg-red-50 rounded-xl transition-colors" data-id="'+c.id+'" aria-label="Remover">' +
            '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18"/><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/><path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/><line x1="10" x2="10" y1="11" y2="17"/><line x1="14" x2="14" y1="11" y2="17"/></svg>' +
          '</button>' +
        '</div>' +
        '<div class="tc-result" data-cid="'+c.id+'">'+resultAreaHtml(c)+'</div>' +
        (albumErrors[c.id]?'<p class="text-red-500 text-xs px-1">'+esc(albumErrors[c.id])+'</p>':'') +
      '</div>';
    }).join("");

    $body().innerHTML =
      '<div class="space-y-4 pt-4">' +
        '<div class="bg-blue-50 rounded-xl p-4 border border-blue-200">' +
          '<p class="text-sm text-blue-800 font-medium mb-1">📝 Adicione o nome das crianças</p>' +
          '<p class="text-xs text-blue-600">Vamos verificar quais álbuns estão disponíveis para cada nome</p>' +
        '</div>' +
        (loadingAlbums?'<div class="flex items-center gap-2 py-2"><div class="w-4 h-4 border-2 border-primary border-t-transparent rounded-full animate-spin"></div><span class="text-xs text-gray-500">Carregando preços...</span></div>':"") +
        '<div id="tc-children" class="space-y-5 max-h-[520px] overflow-y-auto pr-1">'+cards+'</div>' +
        '<button id="tc-add-child" class="w-full py-3 border-2 border-dashed border-primary text-primary rounded-xl hover:bg-primary/5 transition-all flex items-center justify-center gap-2 font-medium">' +
          '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="M12 5v14"/></svg>' +
          'Adicionar outra criança</button>' +
        '<div id="tc-summary">'+(hasSel?buildSummary():"")+'</div>' +
        '<div class="flex items-center justify-center gap-2 text-xs text-gray-400">' +
          '<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="#22c55e" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>' +
          '<span>Personalização ilimitada para todas as crianças</span></div>' +
      '</div>';

    attachStep2();
    updateNextBtn();
  }

  function attachStep2() {
    document.getElementById("tc-add-child").onclick = function(){
      children.push({ id: String(Date.now()), name: "", albumResult: null, isSearching: false, selectedAlbums: [] });
      renderStep2();
    };
    var container = document.getElementById("tc-children");

    container.addEventListener("input", function(e){
      var input = e.target;
      if (!input.classList.contains("tc-child-name")) return;
      var id = input.dataset.id;
      var name = input.value;
      children = children.map(function(c){
        return c.id === id ? Object.assign({}, c, { name: name, albumResult: null, isSearching: name.trim().length >= 2, selectedAlbums: [] }) : c;
      });
      var resultDiv = container.querySelector('.tc-result[data-cid="'+id+'"]');
      if (resultDiv) {
        var child = children.find(function(c){ return c.id === id; });
        resultDiv.innerHTML = child.isSearching
          ? '<div class="flex items-center gap-2 px-3 py-2 bg-gray-50 rounded-xl border border-gray-200"><div class="w-4 h-4 border-2 border-primary border-t-transparent rounded-full animate-spin"></div><span class="text-xs text-gray-500">Buscando álbuns...</span></div>'
          : "";
      }
      debouncedSearch(id, name);
    });

    container.addEventListener("click", function(e){
      var rmBtn = e.target.closest(".tc-rm-child");
      if (rmBtn) {
        var id = rmBtn.dataset.id;
        if (children.length > 1) { children = children.filter(function(c){ return c.id !== id; }); renderStep2(); }
        return;
      }
      var ab = e.target.closest(".tc-album");
      if (ab && !ab.disabled) toggleAlbum(ab.dataset.cid, ab.dataset.key);
      var cg = e.target.closest(".tc-combo-grav");
      if (cg) toggleComboGravado(cg.dataset.cid);
    });
  }

  function updateResultArea(id) {
    var child = children.find(function(c){ return c.id === id; });
    if (!child) return;
    var div = document.querySelector('.tc-result[data-cid="'+id+'"]');
    if (div) div.innerHTML = resultAreaHtml(child);
    var sumDiv = document.getElementById("tc-summary");
    if (sumDiv) sumDiv.innerHTML = buildSummary();
    updateNextBtn();
  }

  // ── Toggle álbum ─────────────────────────────────────────────────────────────
  function toggleAlbum(childId, key) {
    var combo = getCombo();
    var comboId = combo ? combo.id : "combo";
    children = children.map(function(c){
      if (c.id !== childId) return c;
      var sel = c.selectedAlbums || [];
      if (key === "combo") return Object.assign({}, c, { selectedAlbums: sel.indexOf(comboId)>=0 ? [] : [comboId] });
      var realId = key.startsWith("album_") ? (getAlbumByKey(key) ? getAlbumByKey(key).id : key) : key;
      var noCombo = sel.filter(function(a){ return a !== comboId; });
      return Object.assign({}, c, {
        selectedAlbums: noCombo.indexOf(realId)>=0 ? noCombo.filter(function(a){ return a!==realId; }) : noCombo.concat([realId])
      });
    });
    albumErrors[childId] = "";
    renderStep2();
  }

  // ── Debounce + busca ──────────────────────────────────────────────────────────
  function debounce(fn, ms) {
    var t;
    return function() {
      var args = arguments;
      clearTimeout(t);
      t = setTimeout(function(){ fn.apply(null, args); }, ms);
    };
  }

  var debouncedSearch = debounce(function(childId, name) {
    if (!name.trim() || name.trim().length < 2) {
      children = children.map(function(c){
        return c.id===childId ? Object.assign({},c,{albumResult:null,isSearching:false,selectedAlbums:[]}) : c;
      });
      updateResultArea(childId);
      return;
    }
    fetch(API + "/api/children/search?name=" + encodeURIComponent(name.trim()))
      .then(function(r){ return r.json(); })
      .then(function(data){
        children = children.map(function(c){
          return c.id===childId ? Object.assign({},c,{albumResult:data,isSearching:false,selectedAlbums:[]}) : c;
        });
      })
      .catch(function(){
        children = children.map(function(c){
          return c.id===childId ? Object.assign({},c,{albumResult:null,isSearching:false,selectedAlbums:[]}) : c;
        });
      })
      .finally(function(){ updateResultArea(childId); });
  }, 600);

  // ── Validação ─────────────────────────────────────────────────────────────────
  function validateStep1() {
    var e = { fullName: "", email: "", telefone: "" };
    var ok = true;
    if (!customer.fullName.trim()) { e.fullName = "Nome completo é obrigatório"; ok = false; }
    else if (customer.fullName.trim().length < 3) { e.fullName = "Nome deve ter pelo menos 3 caracteres"; ok = false; }
    if (!customer.email.trim()) { e.email = "E-mail é obrigatório"; ok = false; }
    else if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(customer.email)) { e.email = "E-mail inválido"; ok = false; }
    if (!customer.telefone.trim()) { e.telefone = "Telefone é obrigatório"; ok = false; }
    else if (!/^\(\d{2}\) \d{4,5}-\d{4}$/.test(customer.telefone)) { e.telefone = "Telefone inválido. Use (XX) XXXXX-XXXX"; ok = false; }
    errors = e;
    if (!ok) renderStep1();
    return ok;
  }

  function validateStep2() {
    if (children.some(function(c){ return !c.name.trim(); })) {
      alert("Por favor, preencha o nome de todas as crianças"); return false;
    }
    var errs = {};
    children.forEach(function(c){
      if (c.albumResult && c.albumResult.found && !(c.selectedAlbums||[]).length) errs[c.id] = "Selecione pelo menos um álbum";
    });
    if (Object.keys(errs).length) { albumErrors = errs; renderStep2(); return false; }
    return true;
  }

  // ── Fluxo ─────────────────────────────────────────────────────────────────────
  function updateNextBtn() {
    var lbl = $nextLbl();
    if (!lbl) return;
    if (step === 2) {
      var hasSel = children.some(function(c){ return (c.selectedAlbums||[]).length>0; });
      lbl.textContent = hasSel ? "Ir para o Pagamento — R$ "+calcTotal().replace(".",",") : "Ir para o Pagamento";
    } else {
      lbl.textContent = "Continuar";
    }
  }

  function goStep(n) {
    step = n;
    renderHeader();
    n === 1 ? renderStep1() : renderStep2();
    updateNextBtn();
  }

  function fetchAlbums() {
    loadingAlbums = true;
    fetch(API + "/api/albums")
      .then(function(r){ return r.json(); })
      .then(function(j){ if (j.success) albumsAPI = j.data; })
      .catch(function(e){ console.error("Erro ao buscar álbuns:", e); })
      .finally(function(){ loadingAlbums = false; });
  }

  function openModal(detail) {
    detail = detail || {};
    productName = detail.name || "Cantigas Personalizadas";
    isCombo = !!detail.combo;
    step = 1;
    customer = { fullName: "", email: "", telefone: "" };
    children = [{ id: String(Date.now()), name: "", albumResult: null, isSearching: false, selectedAlbums: [] }];
    albumsAPI = []; albumErrors = {}; errors = { fullName: "", email: "", telefone: "" };
    isOpen = true;
    document.getElementById("tc-modal").style.display = "";
    document.body.style.overflow = "hidden";
    renderHeader();
    renderStep1();
    updateNextBtn();
    fetchAlbums();
  }

  function closeModal() {
    isOpen = false;
    document.getElementById("tc-modal").style.display = "none";
    document.body.style.overflow = "";
  }

  // ── Eventos ───────────────────────────────────────────────────────────────────
  window.addEventListener("open-modal", function(e){ openModal(e.detail); });

  document.getElementById("tc-backdrop").onclick = function(){ step===1 ? closeModal() : goStep(1); };

  document.getElementById("tc-next-btn").onclick = function(){
    if (step === 1) {
      if (validateStep1()) goStep(2);
    } else {
      if (validateStep2()) {
        localStorage.setItem("orderData", JSON.stringify({
          customerData: customer, children: children, albumsAPI: albumsAPI,
          productName: productName, total: calcTotal(), isCombo: isCombo
        }));
        closeModal();
        window.location.href = "/pagamento";
      }
    }
  };

  document.addEventListener("keydown", function(e){
    if (e.key === "Escape" && isOpen) step > 1 ? goStep(1) : closeModal();
  });
})();
</script>
