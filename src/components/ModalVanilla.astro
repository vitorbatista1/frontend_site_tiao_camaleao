---
const API_URL = import.meta.env.PUBLIC_API_URL ?? "";
---

<div
  id="tc-modal"
  data-api={API_URL}
  class="fixed inset-0 z-50 flex items-center justify-center p-4"
  style="display:none"
  role="dialog"
  aria-modal="true"
>
  <div id="tc-backdrop" class="absolute inset-0 bg-black/60"></div>
  <div class="relative max-w-md w-full bg-white rounded-3xl shadow-2xl max-h-[90vh] flex flex-col">
    <div id="tc-header" class="sticky top-0 bg-white border-b border-gray-100 p-6 rounded-t-3xl z-10"></div>
    <div id="tc-body" class="px-6 pb-6 overflow-y-auto flex-1 min-h-0"></div>
    <div class="sticky bottom-0 border-t border-gray-100 p-6 bg-gray-50 rounded-b-3xl flex gap-3">
      <button id="tc-back-btn" style="display:none" class="flex-1 bg-green-50 hover:bg-green-100 text-gray-600 font-bold py-2 px-4 rounded-full transition-all flex items-center justify-center shadow-lg uppercase">
        VOLTAR
      </button>
      <button id="tc-next-btn" style="background-color:#6ab248" class="flex-1 hover:opacity-90 text-white font-bold py-2 px-4 rounded-full transition-all flex items-center justify-center shadow-lg uppercase">
        <span id="tc-next-lbl">CONTINUAR</span>
      </button>
    </div>
  </div>
</div>

<script is:inline>
(function () {
