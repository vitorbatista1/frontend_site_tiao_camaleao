    { code:"ID", name:"Indonésia",            dial:"+62",  flag:"🇮🇩" },
    { code:"PH", name:"Filipinas",            dial:"+63",  flag:"🇵🇭" },
    { code:"TH", name:"Tailândia",            dial:"+66",  flag:"🇹🇭" },
    { code:"VN", name:"Vietnã",               dial:"+84",  flag:"🇻🇳" },
    { code:"MY", name:"Malásia",              dial:"+60",  flag:"🇲🇾" },
    { code:"SG", name:"Singapura",            dial:"+65",  flag:"🇸🇬" },
    { code:"IL", name:"Israel",               dial:"+972", flag:"🇮🇱" },
    { code:"TR", name:"Turquia",              dial:"+90",  flag:"🇹🇷" },
    { code:"SA", name:"Arábia Saudita",       dial:"+966", flag:"🇸🇦" },
    { code:"AE", name:"Emirados Árabes",      dial:"+971", flag:"🇦🇪" },
    { code:"AU", name:"Austrália",            dial:"+61",  flag:"🇦🇺" },
    { code:"NZ", name:"Nova Zelândia",        dial:"+64",  flag:"🇳🇿" },
  ];

  // ── Estado ──────────────────────────────────────────────────────────────────
  var isOpen = false, step = 1;
  var childrenCount = 0;
  var customer = { fullName: "", email: "", telefone: "" };
  var selectedCountry = COUNTRIES[0]; // Brasil por padrão
  var countryDropdownOpen = false;
  var countrySearch = "";
  var children = [];
  var albumsAPI = [];
  var loadingAlbums = false;
  var albumErrors = {};
  var albumsExpanded = {};
  var errors = { fullName: "", email: "", telefone: "" };
  var emailCheckState = "idle"; // idle | checking | valid | invalid
  var productName = "";
  var productPrice = 0;
  var isCombo = false;

  // var COMBO_GRAVADO_PRICE_FULL = 150;
  // var COMBO_GRAVADO_ONE_MISSING = 120;
  // var GRAVADO_INDIVIDUAL_UM_FALTANDO = 100;
  // var GRAVADO_INDIVIDUAL_NENHUM = 120;

  var COMBO_GRAVADO_PRICE_FULL = 0;
  var COMBO_GRAVADO_ONE_MISSING = 0;
  var GRAVADO_INDIVIDUAL_UM_FALTANDO = 0;
  var GRAVADO_INDIVIDUAL_NENHUM = 0;

  // ── Helpers de álbum ─────────────────────────────────────────────────────────
  function getAlbumsOnly() { return albumsAPI.filter(function(a){ return a.tipo === "ALBUM"; }); }
  function getCombo() { return albumsAPI.find(function(a){ return a.tipo === "COMBO"; }); }
  function getGravacao() { return albumsAPI.filter(function(a){ return a.tipo === "GRAVACAO"; }); }
  function getComboGravacao() { return getGravacao()[getAlbumsOnly().length] || null; }
  function getComboGravacaoName() { var cg = getComboGravacao(); return cg ? cg.name : "Combo Gravação"; }
  function getGravacaoIndividuais() { return getGravacao().slice(0, getAlbumsOnly().length); }
  function getGravacaoIds() { return getGravacao().map(function(a){ return a.id; }); }
  function isComboGravadoSelected(sel) {
    if (sel.indexOf("personalizado:combo") >= 0) return true;
    var ids = getGravacaoIds();
    return ids.length >= 2 && ids.every(function(id){ return sel.indexOf(id) >= 0; });
  }

  function getAlbumByKey(key) {
    return getAlbumsOnly()[parseInt(key.replace("album_", "")) - 1];
  }
  function getAlbumById(id) { return albumsAPI.find(function(a){ return a.id === id; }); }
  // Acha o registro tipo=GRAVACAO correspondente a um álbum normal (mesma
  // indexação por posição usada em getGravacaoPrice) — usa o nome configurado
  // no admin pra esse produto (ex: "Álbum 1 - Gravação Exclusiva") em vez de
  // inventar "<nome do álbum> Gravação" na marra.
  function getGravacaoAlbumFor(albumId) {
    var albumsOnly = getAlbumsOnly();
    var idx = -1;
    for (var i = 0; i < albumsOnly.length; i++) {
      if (albumsOnly[i].id === albumId) { idx = i; break; }
    }
    if (idx < 0) return null;
    return getGravacao()[idx] || null;
  }
  function getGravacaoLabel(albumId) {
    var grav = getGravacaoAlbumFor(albumId);
    if (grav) return grav.name;
    var orig = getAlbumById(albumId);
    return orig ? orig.name + " Gravação" : "Gravação";
  }
  function getAlbumLabel(id) {
    if (id === "personalizado:combo") return getComboGravacaoName();
    if (id.startsWith("personalizado:")) return getGravacaoLabel(id.slice(14));
    var a = getAlbumById(id);
    return a ? a.name : id;
  }

  function priceOf(keyOrId) {
    if (keyOrId.startsWith("personalizado:")) return 0;
    var a = keyOrId.startsWith("album_") ? getAlbumByKey(keyOrId) : getAlbumById(keyOrId);
    return parseFloat((a && a.priceNew) || "0");
  }
  function getGravacaoPrice(albumId) {
    var albumsOnly = getAlbumsOnly();
    var idx = -1;
    for (var i = 0; i < albumsOnly.length; i++) {
      if (albumsOnly[i].id === albumId) { idx = i; break; }
    }
    if (idx < 0) return 0;
    var gravs = getGravacao();
    return gravs[idx] ? parseFloat(gravs[idx].priceNew || 0) : 0;
  }
  function priceOldOf(keyOrId) {
    var a = keyOrId.startsWith("album_") ? getAlbumByKey(keyOrId) : getAlbumById(keyOrId);
    return parseFloat((a && a.priceOld) || "0");
  }
  function calcSubtotal(sel, foundAlbumsCount) {
    if (isComboGravadoSelected(sel)) {
      return (foundAlbumsCount >= 1) ? COMBO_GRAVADO_ONE_MISSING : COMBO_GRAVADO_PRICE_FULL;
    }
    var gravIds = getGravacaoIds();
    return sel.reduce(function(s, k) {
      if (k.startsWith("personalizado:") && k !== "personalizado:combo") {
        return s + getGravacaoPrice(k.slice(14));
      }
      if (gravIds.indexOf(k) >= 0) {
        return s + priceOf(k);
      }
      return s + priceOf(k);
    }, 0);
  }
  function calcTotal() {
    return children.reduce(function(t, c) {
      var sel = c.selectedAlbums || [];
      var foundCount = (c.albumResult && c.albumResult.found) ? (c.albumResult.albums || []).length : 0;
      return t + calcSubtotal(sel, foundCount);
    }, 0).toFixed(2);
  }

  // ── DOM ──────────────────────────────────────────────────────────────────────
  function $header() { return document.getElementById("tc-header"); }
  function $body()   { return document.getElementById("tc-body"); }
  function $nextLbl(){ return document.getElementById("tc-next-lbl"); }

  function esc(s) {
    return String(s == null ? "" : s)
      .replace(/&/g,"&amp;").replace(/</g,"&lt;")
      .replace(/>/g,"&gt;").replace(/"/g,"&quot;");
  }

  // ── Header ────────────────────────────────────────────────────────────────────
  function renderHeader() {
    var titles = ["Informe seus dados", "Quantidade de Crianças", "Nome da(s) criança(s)"];
    var descs = ["Você está comprando para quantas crianças?", "Adicione o nome das crianças"];
    $header().innerHTML =
      '<div class="flex items-start">' +
        '<div class="flex-1">' +
          '<h2 class="text-2xl font-bold text-gray-800">' + titles[step - 1] + '</h2>' +
          '<p class="text-sm text-gray-500 mt-1">' + descs[step - 1] + '</p>' +
        '</div>' +
        '<button id="tc-close" class="p-2 hover:bg-gray-100 rounded-full transition-colors ml-2 flex-shrink-0" aria-label="Fechar">' +
          '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-gray-500"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>' +
        '</button>' +
      '</div>' +
      '<div class="flex gap-2 mt-6">' +
        '<div class="flex-1 h-1 rounded-full bg-primary"></div>' +
        '<div class="flex-1 h-1 rounded-full transition-all ' + (step >= 2 ? "bg-primary" : "bg-gray-200") + '"></div>' +
        '<div class="flex-1 h-1 rounded-full transition-all ' + (step >= 3 ? "bg-primary" : "bg-gray-200") + '"></div>' +
      '</div>';
    document.getElementById("tc-close").onclick = function(){ closeModal(); };
  }

  // ── Step 2 — Quantidade de crianças ──────────────────────────────────────────
  function renderStep2() {
    var options = [1, 2, 3, 4, 5, 6];
    var customSelected = childrenCount > 0 && options.indexOf(childrenCount) < 0;
    var btns = options.map(function(n) {
      var sel = childrenCount === n;
      var cls = sel
        ? "border-primary bg-primary text-white shadow-md"
        : "border-gray-200 hover:border-primary hover:bg-primary/5 text-gray-700";
      return '<button type="button" class="tc-qty-btn flex items-center justify-center text-2xl font-bold rounded-2xl border-2 transition-all py-5 ' + cls + '" data-qty="' + n + '" style="min-width:0">' + n + '</button>';
    }).join("");

    $body().innerHTML =
      '<div class="space-y-6 pt-4">' +
        '<div class="bg-blue-50 rounded-xl p-4 border border-blue-200">' +
          '<p class="text-sm text-blue-800 font-medium mb-1">👧👦 Quantas crianças vão receber?</p>' +
          '<p class="text-xs text-blue-600">Selecione o número ou digite outra quantidade</p>' +
        '</div>' +
        '<div id="tc-qty-grid" class="grid grid-cols-3 gap-3">' + btns + '</div>' +
        '<div class="flex items-center gap-3">' +
          '<div class="flex-1 h-px bg-gray-200"></div>' +
          '<span class="text-xs text-gray-400 whitespace-nowrap">ou digite outra quantidade</span>' +
          '<div class="flex-1 h-px bg-gray-200"></div>' +
        '</div>' +
        '<input id="tc-qty-custom" type="number" min="1" max="50" placeholder="Ex: 10" value="' + (customSelected ? childrenCount : "") + '"' +
          ' class="w-full px-4 py-3 border-2 rounded-xl focus:outline-none transition-colors text-center text-xl font-bold ' +
          (customSelected ? "border-primary" : "border-gray-200 focus:border-primary") + '" />' +
      '</div>';

    document.getElementById("tc-qty-grid").addEventListener("click", function(e) {
      var btn = e.target.closest(".tc-qty-btn");
      if (!btn) return;
      childrenCount = parseInt(btn.dataset.qty);
      document.getElementById("tc-qty-custom").value = "";
      renderStep2();
      updateNextBtn();
    });

    document.getElementById("tc-qty-custom").addEventListener("input", function(e) {
      var val = parseInt(e.target.value);
      childrenCount = (!isNaN(val) && val >= 1) ? val : 0;
      updateNextBtn();
    });

    updateNextBtn();
  }

  // ── Validação de domínio de e-mail ───────────────────────────────────────────
  function doEmailCheck(emailVal) {
    if (emailCheckState === "checking") return;
    emailCheckState = "checking";
    fetch(API + "/api/validate-email", {
      method: "POST", headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ email: emailVal })
    })
    .then(function(r){ return r.json(); })
    .then(function(data){
      emailCheckState = data.valid ? "valid" : "invalid";
      if (!data.valid) errors.email = "E-mail inválido ou domínio inexistente";
      else errors.email = "";
      updateEmailUI();
    })
    .catch(function(){
      emailCheckState = "valid"; // fail open em erro de rede
      errors.email = "";
      updateEmailUI();
    });
  }

  function updateEmailUI() {
    var emailInput = document.getElementById("tc-email");
    if (!emailInput) return;
    var wrapper = emailInput.parentElement;
    // Atualiza borda
    var bc = errors.email ? "border-red-500" :
             emailCheckState === "checking" ? "border-yellow-400" :
             "border-green-600 focus:border-green-700";
    emailInput.className = "w-full px-4 py-3 border-2 rounded-xl focus:outline-none transition-colors bg-green-50 " + bc;
    // Remove mensagem anterior
    var prev = wrapper.querySelector(".tc-email-msg");
    if (prev) prev.remove();
    // Adiciona nova mensagem
    var msgEl = document.createElement("p");
    msgEl.className = "text-xs mt-1 tc-email-msg";
    if (errors.email) {
      msgEl.classList.add("text-red-500");
      msgEl.textContent = errors.email;
      wrapper.appendChild(msgEl);
    } else if (emailCheckState === "checking") {
      msgEl.classList.add("text-yellow-600");
      msgEl.textContent = "Verificando e-mail...";
      wrapper.appendChild(msgEl);
    } else if (emailCheckState === "valid" && customer.email) {
      msgEl.classList.add("text-green-600");
      msgEl.textContent = "✓ E-mail verificado";
      wrapper.appendChild(msgEl);
    }
  }

  // ── Step 1 ────────────────────────────────────────────────────────────────────
  function renderStep1() {
    function field(id, type, label, ph, val, err) {
      return '<div>' +
        '<label for="'+id+'" class="block text-[22px] font-semibold text-black mb-1">'+esc(label)+' <span class="text-red-500">*</span></label>' +
        '<input id="'+id+'" type="'+type+'" placeholder="'+ph+'" value="'+esc(val)+'"' +
        ' class="w-full px-4 py-3 border-2 rounded-xl focus:outline-none transition-colors bg-green-50 ' +
        (err ? "border-red-500" : "border-green-600 focus:border-green-700") + '" />' +
        (err ? '<p class="text-red-500 text-xs mt-1">'+esc(err)+'</p>' : '') + '</div>';
    }
    var emailStatusHtml = "";
    if (!errors.email) {
      if (emailCheckState === "checking") emailStatusHtml = '<p class="text-yellow-600 text-xs mt-1 tc-email-msg">Verificando e-mail...</p>';
      else if (emailCheckState === "valid" && customer.email) emailStatusHtml = '<p class="text-green-600 text-xs mt-1 tc-email-msg">✓ E-mail verificado</p>';
    }
    var emailBorder = errors.email ? "border-red-500" :
                      emailCheckState === "checking" ? "border-yellow-400" :
                      "border-green-600 focus:border-green-700";
    var emailFieldHtml = '<div>' +
      '<label for="tc-email" class="block text-[22px] font-semibold text-black mb-1">E-mail <span class="text-red-500">*</span></label>' +
      '<input id="tc-email" type="email" placeholder="Digite seu melhor e-mail" value="'+esc(customer.email)+'"' +
      ' class="w-full px-4 py-3 border-2 rounded-xl focus:outline-none transition-colors bg-green-50 '+emailBorder+'" />' +
      (errors.email ? '<p class="text-red-500 text-xs mt-1 tc-email-msg">'+esc(errors.email)+'</p>' : emailStatusHtml) +
    '</div>';
    var filteredCountries = countrySearch.trim()
      ? COUNTRIES.filter(function(c){
          var q = countrySearch.toLowerCase();
          return c.name.toLowerCase().indexOf(q) >= 0 || c.dial.indexOf(q) >= 0 || c.code.toLowerCase().indexOf(q) >= 0;
        })
      : COUNTRIES;
    var dropdownItems = filteredCountries.map(function(c){
      var active = c.code === selectedCountry.code ? ' style="background:#f0fdf4;color:#6ab248;font-weight:600"' : '';
      return '<button type="button" class="tc-country-item w-full flex items-center gap-2 px-3 py-2 hover:bg-gray-50 text-sm text-gray-700 transition-colors"'+active+' data-code="'+c.code+'">' +
        '<span style="font-size:1.1em;line-height:1">'+c.flag+'</span>' +
        '<span style="flex:1;text-align:left;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">'+esc(c.name)+'</span>' +
        '<span style="color:#9ca3af;font-size:.75em;font-family:monospace;flex-shrink:0">'+c.dial+'</span>' +
      '</button>';
    }).join("");
    var phoneBorder = errors.telefone ? "border-red-500" : "border-green-600";
    var phoneFieldHtml =
      '<div>' +
        '<label class="block text-[22px] font-semibold text-black mb-1">WhatsApp <span class="text-red-500">*</span></label>' +
        '<div class="flex border-2 rounded-xl bg-green-50 transition-colors '+phoneBorder+'" style="overflow:visible">' +
          '<div style="position:relative;flex-shrink:0">' +
            '<button type="button" id="tc-country-btn" class="flex items-center gap-1 px-3 py-3 border-r border-green-600 bg-green-100 hover:bg-green-200 transition-colors rounded-l-xl text-sm font-medium text-gray-700 whitespace-nowrap h-full" style="border-top-right-radius:0;border-bottom-right-radius:0">' +
              '<span style="font-size:1.1em;line-height:1">'+selectedCountry.flag+'</span>' +
              '<span style="font-family:monospace;font-size:.8em;color:#374151">'+selectedCountry.dial+'</span>' +
              '<span style="color:#9ca3af;font-size:.65em">▾</span>' +
            '</button>' +
            (countryDropdownOpen ?
              '<div id="tc-country-dd" style="position:absolute;top:100%;left:0;margin-top:4px;width:280px;background:#fff;border:1px solid #e5e7eb;border-radius:12px;box-shadow:0 10px 25px rgba(0,0,0,.15);z-index:999;overflow:hidden">' +
                '<div style="padding:8px;border-bottom:1px solid #f3f4f6">' +
                  '<input id="tc-country-search" type="text" placeholder="Buscar país ou código..." value="'+esc(countrySearch)+'" style="width:100%;padding:6px 12px;font-size:.875rem;border:1px solid #e5e7eb;border-radius:8px;outline:none" />' +
                '</div>' +
                '<div style="max-height:210px;overflow-y:auto">' +
                  (dropdownItems || '<p style="text-align:center;font-size:.75rem;color:#9ca3af;padding:12px">Nenhum país encontrado</p>') +
                '</div>' +
              '</div>'
            : '') +
          '</div>' +
          '<input id="tc-phone" type="tel" placeholder="'+(selectedCountry.code==="BR" ? "(DDD) 9XXXX-XXXX" : "Somente dígitos")+' *" value="'+esc(customer.telefone)+'" style="flex:1;padding:12px 16px;outline:none;background:transparent;border-radius:0 12px 12px 0;min-width:0;font-size:.875rem" />' +
        '</div>' +
        (errors.telefone ? '<p class="text-red-500 text-xs mt-1">'+esc(errors.telefone)+'</p>' : '') +
      '</div>';

    $body().innerHTML =
      '<div class="space-y-4 pt-4"><div class="space-y-3">' +
        field("tc-name",  "text",  "Nome completo", "Digite seu nome completo", customer.fullName, errors.fullName) +
        emailFieldHtml +
        phoneFieldHtml +
      '</div><div class="bg-amber-50 rounded-xl p-3 border border-amber-200">' +
        '<p class="text-xs text-amber-800"><strong>Campos obrigatórios:</strong> Nome completo, E-mail e Telefone</p>' +
      '</div></div>';

    document.getElementById("tc-name").addEventListener("input", function(e){
      customer.fullName = e.target.value;
      if (errors.fullName) { errors.fullName = ""; renderStep1(); }
    });
    document.getElementById("tc-email").addEventListener("input", function(e){
      customer.email = e.target.value;
      emailCheckState = "idle";
      if (errors.email) { errors.email = ""; renderStep1(); }
    });
    document.getElementById("tc-email").addEventListener("blur", function(e){
      var val = e.target.value.trim();
      if (val && /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(val) && emailCheckState === "idle") {
        doEmailCheck(val);
        updateEmailUI();
      }
    });

    // Botão do seletor de país
    document.getElementById("tc-country-btn").addEventListener("click", function(){
      countryDropdownOpen = !countryDropdownOpen;
      countrySearch = "";
      renderStep1();
      if (countryDropdownOpen) {
        var s = document.getElementById("tc-country-search");
        if (s) s.focus();
      }
    });

    // Busca dentro do dropdown
    if (countryDropdownOpen) {
      var searchEl = document.getElementById("tc-country-search");
      if (searchEl) {
        searchEl.addEventListener("input", function(e){
          countrySearch = e.target.value;
          renderStep1();
          if (countryDropdownOpen) {
            var ns = document.getElementById("tc-country-search");
            if (ns) { ns.focus(); ns.value = countrySearch; ns.setSelectionRange(countrySearch.length, countrySearch.length); }
          }
        });
        searchEl.addEventListener("click", function(e){ e.stopPropagation(); });
      }

      // Selecionar país
      var items = document.querySelectorAll(".tc-country-item");
      items.forEach(function(btn){
        btn.addEventListener("click", function(){
          var code = btn.dataset.code;
          selectedCountry = COUNTRIES.find(function(c){ return c.code === code; }) || COUNTRIES[0];
          countryDropdownOpen = false;
          countrySearch = "";
          customer.telefone = "";
          if (errors.telefone) errors.telefone = "";
          renderStep1();
        });
      });

      // Fechar ao clicar fora
      setTimeout(function(){
        document.addEventListener("mousedown", function closeDd(ev){
          var dd = document.getElementById("tc-country-dd");
          var btn2 = document.getElementById("tc-country-btn");
          if (dd && !dd.contains(ev.target) && btn2 && !btn2.contains(ev.target)) {
            countryDropdownOpen = false;
            countrySearch = "";
            renderStep1();
          }
          document.removeEventListener("mousedown", closeDd);
        });
      }, 0);
    }

    // Máscara do telefone
    document.getElementById("tc-phone").addEventListener("input", function(e){
      var input = e.target;
      var digits = input.value.replace(/\D/g, "");
      var fmt;
      if (selectedCountry.code === "BR") {
        digits = digits.slice(0, 11);
        fmt = digits.length <= 10
          ? digits.replace(/^(\d{0,2})(\d{0,4})(\d{0,4})$/, function(_,a,b,c){ return (a?"("+a:"") + (b?") "+b:"") + (c?"-"+c:""); })
          : digits.replace(/^(\d{0,2})(\d{0,5})(\d{0,4})$/, function(_,a,b,c){ return (a?"("+a:"") + (b?") "+b:"") + (c?"-"+c:""); });
      } else {
        // E.164: max 15 dígitos para qualquer país
        digits = digits.slice(0, 15);
        fmt = digits;
      }
      customer.telefone = fmt;
      input.value = fmt;
      if (errors.telefone) { errors.telefone = ""; renderStep1(); }
    });
  }

  // ── Toggle combo gravado ──────────────────────────────────────────────────────
  function toggleComboGravado(childId) {
    var newSel = [];
    children = children.map(function(c){
      if (c.id !== childId) return c;
      var sel = c.selectedAlbums || [];
      var ativo = isComboGravadoSelected(sel);
      var result;
      if (ativo) {
        var gravIds = getGravacaoIds();
        result = sel.filter(function(id){
          return id !== "personalizado:combo" && gravIds.indexOf(id) < 0 && !id.startsWith("personalizado:");
        });
      } else {
        result = ["personalizado:combo"];
      }
      newSel = result;
      return Object.assign({}, c, { selectedAlbums: result });
    });
    albumErrors[childId] = "";
    if (newSel.length > 0) albumsExpanded[childId] = false;
    renderStep3();
  }

  // ── SVG check ─────────────────────────────────────────────────────────────────
  var CHECK = '<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>';

  // selectedGreen=true faz o estado selecionado ficar verde (usado quando a
  // criança não tinha nenhum álbum gravado) em vez de amarelo (caso "misto",
  // quando já tinha algum álbum e está completando com gravação).
  function comboGravadoBtn(childId, ativo, price, selectedGreen) {
    var activeCls = selectedGreen ? "border-green-500 bg-green-50" : "border-yellow-500 bg-yellow-50";
    var activeDot = selectedGreen ? "border-green-500 bg-green-500" : "border-yellow-500 bg-yellow-500";
    var textCls = (ativo && selectedGreen) ? "text-green-700" : "text-yellow-700";
    var subTextCls = (ativo && selectedGreen) ? "text-green-600" : "text-yellow-600";
    var cls = ativo ? activeCls : "border-dashed border-yellow-400 hover:bg-yellow-50";
    var dotCls = ativo ? activeDot : "border-yellow-400";
    return '<button type="button" class="tc-combo-grav w-full flex items-center justify-between px-4 py-3 rounded-xl border-2 transition-all '+cls+'" data-cid="'+childId+'">' +
      '<div class="flex items-center gap-2">' +
        '<div class="w-5 h-5 rounded-full border-2 flex items-center justify-center flex-shrink-0 '+dotCls+'">'+(ativo?CHECK:'')+'</div>' +
        '<div class="text-left">' +
          '<span class="text-sm font-bold '+textCls+' block">🎁 ' + esc(getComboGravacaoName()) + '</span>' +
          '<span class="text-xs '+subTextCls+'">Os 2 álbuns gravados — melhor custo-benefício!</span>' +
        '</div>' +
      '</div>' +
      '<span class="text-sm font-bold '+textCls+' ml-2 flex-shrink-0">R$ '+price.toFixed(2).replace(".",",")+'</span>' +
    '</button>';
  }

  function albumBtn(childId, key, selected, disabled, label, pNew, pOld, selCls, unselCls, checkCls, green) {
    var disAttr = disabled ? " disabled" : "";
    var wrapCls = disabled
      ? "border-gray-100 bg-gray-50 opacity-50 cursor-not-allowed"
      : selected ? selCls : unselCls;
    var dotCls = selected ? checkCls : "border-gray-300";
    var textCls = green ? "text-green-700 font-bold" : "";
    var priceCls = green ? "text-green-700" : "text-gray-700";
    var strikeColor = green ? "text-green-500" : "text-gray-400";
    return (
      '<button type="button"'+disAttr+' class="tc-album w-full flex items-center justify-between px-4 py-3 rounded-xl border-2 transition-all '+wrapCls+'" data-cid="'+childId+'" data-key="'+key+'">' +
        '<div class="flex items-center gap-2">' +
          '<div class="w-5 h-5 rounded-full border-2 flex items-center justify-center flex-shrink-0 '+dotCls+'">'+(selected?CHECK:'')+'</div>' +
          '<span class="text-sm font-medium text-left '+textCls+'">'+esc(label)+'</span>' +
        '</div>' +
        '<div class="text-right flex-shrink-0 ml-2">' +
          (pOld>pNew?'<span class="text-xs '+strikeColor+' line-through block">R$ '+pOld.toFixed(2).replace(".",",")+'</span>':'') +
          '<span class="text-sm font-bold '+priceCls+'">R$ '+pNew.toFixed(2).replace(".",",")+'</span>' +
        '</div>' +
      '</button>'
    );
  }

  function buildFoundAlbums(child) {
    var sel = child.selectedAlbums || [];
    var isExpanded = !sel.length || albumsExpanded[child.id] === true;

    if (!isExpanded) {
      var foundCount = (child.albumResult && child.albumResult.found) ? (child.albumResult.albums || []).length : 0;
      var sub = calcSubtotal(sel, foundCount);
      var labels = isComboGravadoSelected(sel) ? [getComboGravacaoName()] : sel.map(function(k){ return esc(getAlbumLabel(k)); });
      return '<button type="button" class="tc-alterar w-full flex items-center gap-3 px-4 py-3 bg-green-50 border-2 border-green-400 rounded-xl hover:bg-green-100 transition-colors" data-cid="'+child.id+'">' +
        '<div class="w-6 h-6 rounded-full bg-green-500 flex items-center justify-center flex-shrink-0">' + CHECK + '</div>' +
        '<span class="flex-1 text-sm font-semibold text-green-800 text-left truncate">' + labels.join(" + ") + '</span>' +
        '<span class="text-sm font-bold text-green-700 flex-shrink-0">R$ ' + sub.toFixed(2).replace(".", ",") + '</span>' +
        '<span class="text-xs text-green-700 flex-shrink-0 border border-green-500 rounded-lg px-2 py-0.5 bg-white ml-1">Alterar ▾</span>' +
      '</button>';
    }

    var combo = getCombo();
    var comboId = combo ? combo.id : "combo";
    var comboSel = sel.indexOf(comboId) >= 0;
    var comboGravSel = isComboGravadoSelected(sel);

    // álbuns digitais já gravados (disponíveis para compra)
    var btns = (child.albumResult.albums || []).map(function(albumId){
      var a = getAlbumById(albumId);
      var isSelected = sel.indexOf(albumId) >= 0;
      return albumBtn(child.id, albumId, isSelected && !comboGravSel, comboSel || comboGravSel,
        a ? a.name : getAlbumLabel(albumId),
        parseFloat((a && a.priceNew) || "0"),
        parseFloat((a && a.priceOld) || "0"),
        "border-primary bg-primary/5", "border-gray-200 hover:border-primary/50 hover:bg-gray-50",
        "border-primary bg-primary", false);
    }).join("");

    // combo digital (verde) — só se tiver 2+ álbuns gravados
    var comboBtn = "";
    if ((child.albumResult.albums||[]).length >= 2 && combo) {
      var cs = sel.indexOf(combo.id) >= 0;
      comboBtn = albumBtn(child.id, "combo", cs, false,
        "🎁 "+combo.name, parseFloat(combo.priceNew), parseFloat(combo.priceOld),
        "border-green-500 bg-green-50", "border-dashed border-green-400 hover:bg-green-50",
        "border-green-500 bg-green-500", true);
    }

    // seção de gravação para álbuns faltantes
    var gravSection = "";
    var albumsOnly = getAlbumsOnly();
    var childAlbumIds = child.albumResult.albums || [];
    var missing = albumsOnly.filter(function(a){ return childAlbumIds.indexOf(a.id) < 0; });

    var missingWithGravacao = missing.filter(function(a){ return getGravacaoPrice(a.id) > 0; });
    if (missingWithGravacao.length > 0) {
      if (missingWithGravacao.length >= 2) {
        var allGravBtns = missingWithGravacao.map(function(a) {
          var vKey = "personalizado:" + a.id;
          var gravSel2 = sel.indexOf(vKey) >= 0;
          return albumBtn(child.id, vKey, gravSel2 && !comboGravSel, comboGravSel,
            "🎙️ " + getGravacaoLabel(a.id),
            getGravacaoPrice(a.id),
            0,
            "border-yellow-500 bg-yellow-50", "border-dashed border-yellow-400 hover:bg-yellow-50",
            "border-yellow-500 bg-yellow-500", false);
        }).join("");
        var comboGravPrice = COMBO_GRAVADO_PRICE_FULL;
        gravSection =
          '<div class="space-y-1 pt-1">' +
            '<p class="text-xs font-semibold text-yellow-600 px-1">🎙️ Grave os álbuns com o nome de ' + esc(child.albumResult.display_name || child.name) + ':</p>' +
            allGravBtns +
            comboGravadoBtn(child.id, comboGravSel, comboGravPrice) +
          '</div>';
      } else {
        var mAlbum = missingWithGravacao[0];
        var vKey1 = "personalizado:" + mAlbum.id;
        var gravSel = sel.indexOf(vKey1) >= 0;
        var mGravPrice = getGravacaoPrice(mAlbum.id);
        var comboOneMissingPrice = COMBO_GRAVADO_ONE_MISSING;
        var gravBtnHtml = albumBtn(child.id, vKey1, gravSel && !comboGravSel, comboGravSel,
          "🎙️ " + getGravacaoLabel(mAlbum.id),
          mGravPrice,
          0,
          "border-yellow-500 bg-yellow-50", "border-dashed border-yellow-400 hover:bg-yellow-50",
          "border-yellow-500 bg-yellow-500", false);
        gravSection =
          '<div class="space-y-1 pt-1">' +
            '<p class="text-xs font-semibold text-yellow-600 px-1">🎙️ Disponíveis para gravação:</p>' +
            gravBtnHtml +
            comboGravadoBtn(child.id, comboGravSel, comboOneMissingPrice) +
          '</div>';
      }
    }

    return '<div class="space-y-2">' +
      '<p class="text-[16px] font-semibold text-gray-600 px-1">Selecione o(s) álbums(s) para <span class="text-primary">'+esc(child.albumResult.display_name||child.name)+'</span>:</p>' +
      '<div class="space-y-2">'+btns+comboBtn+'</div>' +
      gravSection +
    '</div>';
  }

  function buildNotFound(child) {
    var sel = child.selectedAlbums || [];
    var isExpanded = !sel.length || albumsExpanded[child.id] === true;

    if (!isExpanded) {
      var sub = calcSubtotal(sel, 0);
      var labels = isComboGravadoSelected(sel) ? [getComboGravacaoName()] : sel.map(function(k){ return esc(getAlbumLabel(k)); });
      return '<button type="button" class="tc-alterar w-full flex items-center gap-3 px-4 py-3 bg-green-50 border-2 border-green-400 rounded-xl hover:bg-green-100 transition-colors" data-cid="'+child.id+'">' +
        '<div class="w-6 h-6 rounded-full bg-green-500 flex items-center justify-center flex-shrink-0">' + CHECK + '</div>' +
        '<span class="flex-1 text-sm font-semibold text-green-800 text-left truncate">' + labels.join(" + ") + '</span>' +
        '<span class="text-sm font-bold text-green-700 flex-shrink-0">R$ ' + sub.toFixed(2).replace(".", ",") + '</span>' +
        '<span class="text-xs text-green-700 flex-shrink-0 border border-green-500 rounded-lg px-2 py-0.5 bg-white ml-1">Alterar ▾</span>' +
      '</button>';
    }

    var albumsOnly = getAlbumsOnly();
    var comboGravSel = isComboGravadoSelected(sel);

    var albumsOnlyWithGravacao = albumsOnly.filter(function(a){ return getGravacaoPrice(a.id) > 0; });
    var btns = albumsOnlyWithGravacao.map(function(a) {
      var vKey = "personalizado:" + a.id;
      var isSel = sel.indexOf(vKey) >= 0;
      return albumBtn(child.id, vKey, isSel && !comboGravSel, comboGravSel,
        "🎙️ " + getGravacaoLabel(a.id), getGravacaoPrice(a.id), 0,
        "border-green-500 bg-green-50", "border-dashed border-yellow-400 hover:bg-yellow-50",
        "border-green-500 bg-green-500", false);
    }).join("");

    var notFoundComboPrice = COMBO_GRAVADO_PRICE_FULL;
    var comboBtn = albumsOnlyWithGravacao.length >= 2
      ? comboGravadoBtn(child.id, comboGravSel, notFoundComboPrice, true)
      : "";

    return '<div class="space-y-2">' +
      '<div class="px-3 py-2 bg-amber-50 border border-amber-200 rounded-xl">' +
        '<p class="text-xs text-amber-700">⚠️ Nenhum álbum encontrado para <strong>"' + esc(child.name) + '"</strong>. Grave com o nome da criança:</p>' +
      '</div>' +
      '<div class="space-y-1">' +
        '<p class="text-xs font-semibold text-yellow-600 px-1">🎙️ Disponíveis para gravação:</p>' +
        btns + comboBtn +
      '</div>' +
    '</div>';
  }

  function buildSummary() {
    var rows = children.map(function(c){
      var sel = c.selectedAlbums || [];
      if (!c.name || !sel.length) return "";
      var foundCount = (c.albumResult && c.albumResult.found) ? (c.albumResult.albums || []).length : 0;
      var sub = calcSubtotal(sel, foundCount);
      var labels = isComboGravadoSelected(sel)
        ? [getComboGravacaoName()]
        : sel.map(function(k){ return esc(getAlbumLabel(k)); });
      return '<div class="flex justify-between text-xs text-gray-600">' +
        '<span>'+esc(c.albumResult&&c.albumResult.display_name||c.name)+' — '+labels.join(" + ")+'</span>' +
        '<span class="font-semibold">R$ '+sub.toFixed(2).replace(".",",")+'</span></div>';
    }).join("");
    if (!rows) return "";
    return '<div class="bg-gray-50 rounded-xl p-4 border border-gray-200 space-y-2">' +
      '<p class="text-sm font-semibold text-gray-700">Resumo:</p>'+rows+
      '<div class="border-t border-gray-300 pt-2 flex justify-between font-bold text-gray-800">' +
        '<span>Total</span><span>R$ '+calcTotal().replace(".",",")+'</span></div></div>';
  }

  function resultAreaHtml(child) {
    if (child.isSearching) {
      return '<div class="flex items-center gap-2 px-3 py-2 bg-gray-50 rounded-xl border border-gray-200">' +
        '<div class="w-4 h-4 border-2 border-primary border-t-transparent rounded-full animate-spin"></div>' +
        '<span class="text-xs text-gray-500">Buscando álbuns...</span></div>';
    }
    if (child.albumResult && child.albumResult.found) return buildFoundAlbums(child);
    if (child.albumResult && !child.albumResult.found && child.name.trim().length >= 2) return buildNotFound(child);
    return "";
  }

  // ── Step 3 ────────────────────────────────────────────────────────────────────
  function renderStep3() {
    var hasSel = children.some(function(c){ return (c.selectedAlbums||[]).length > 0; });
    var cards = children.map(function(c, idx){
      return '<div class="space-y-2" data-cid="'+c.id+'">' +
        '<input type="text" placeholder="Nome da criança '+(idx+1)+' *" value="'+esc(c.name)+'"' +
          ' class="tc-child-name w-full px-4 py-3 border-2 border-gray-200 rounded-xl focus:border-primary focus:outline-none transition-colors"' +
          ' data-id="'+c.id+'" />' +
        '<div class="tc-result" data-cid="'+c.id+'">'+resultAreaHtml(c)+'</div>' +
        (albumErrors[c.id]?'<p class="text-red-500 text-xs px-1">'+esc(albumErrors[c.id])+'</p>':'') +
      '</div>';
    }).join("");

    $body().innerHTML =
      '<div class="space-y-4 pt-4">' +
        '<div class="bg-blue-50 rounded-xl p-4 border border-blue-200">' +
          '<p class="text-sm text-blue-800 font-medium mb-1">📝 Adicione o nome das crianças</p>' +
          '<p class="text-xs text-blue-600">Vamos verificar quais álbuns estão disponíveis para cada nome</p>' +
        '</div>' +
        (loadingAlbums?'<div class="flex items-center gap-2 py-2"><div class="w-4 h-4 border-2 border-primary border-t-transparent rounded-full animate-spin"></div><span class="text-xs text-gray-500">Carregando preços...</span></div>':"") +
        '<div id="tc-children" class="space-y-5 max-h-[520px] overflow-y-auto pr-1">'+cards+'</div>' +
        '<div id="tc-summary">'+(hasSel?buildSummary():"")+'</div>' +
        '<div class="flex items-center justify-center gap-2 text-xs text-gray-400">' +
      '</div>';

    attachStep3();
    updateNextBtn();
  }

  function attachStep3() {
    var container = document.getElementById("tc-children");

    container.addEventListener("input", function(e){
      var input = e.target;
      if (!input.classList.contains("tc-child-name")) return;
      var id = input.dataset.id;
      var name = input.value;
      children = children.map(function(c){
        return c.id === id ? Object.assign({}, c, { name: name, albumResult: null, isSearching: name.trim().length >= 2, selectedAlbums: [] }) : c;
      });
      var resultDiv = container.querySelector('.tc-result[data-cid="'+id+'"]');
      if (resultDiv) {
        var child = children.find(function(c){ return c.id === id; });
        resultDiv.innerHTML = child.isSearching
          ? '<div class="flex items-center gap-2 px-3 py-2 bg-gray-50 rounded-xl border border-gray-200"><div class="w-4 h-4 border-2 border-primary border-t-transparent rounded-full animate-spin"></div><span class="text-xs text-gray-500">Buscando álbuns...</span></div>'
          : "";
      }
      debouncedSearch(id, name);
    });

    container.addEventListener("click", function(e){
      var ab = e.target.closest(".tc-album");
      if (ab && !ab.disabled) toggleAlbum(ab.dataset.cid, ab.dataset.key);
      var cg = e.target.closest(".tc-combo-grav");
      if (cg) toggleComboGravado(cg.dataset.cid);
      var al = e.target.closest(".tc-alterar");
      if (al) { albumsExpanded[al.dataset.cid] = true; renderStep3(); }
    });
  }

  function updateResultArea(id) {
    var child = children.find(function(c){ return c.id === id; });
    if (!child) return;
    var div = document.querySelector('.tc-result[data-cid="'+id+'"]');
    if (div) div.innerHTML = resultAreaHtml(child);
    var sumDiv = document.getElementById("tc-summary");
    if (sumDiv) sumDiv.innerHTML = buildSummary();
    updateNextBtn();
  }

  // ── Toggle álbum ─────────────────────────────────────────────────────────────
  function toggleAlbum(childId, key) {
    var combo = getCombo();
    var comboId = combo ? combo.id : "combo";
    var newSel = [];
    children = children.map(function(c){
      if (c.id !== childId) return c;
      var sel = c.selectedAlbums || [];
      var result;
      if (key === "combo") {
        result = sel.indexOf(comboId)>=0 ? [] : [comboId];
      } else {
        var realId = key.startsWith("album_") ? (getAlbumByKey(key) ? getAlbumByKey(key).id : key) : key;
        var noCombo = sel.filter(function(a){ return a !== comboId && a !== "personalizado:combo"; });
        result = noCombo.indexOf(realId)>=0 ? noCombo.filter(function(a){ return a!==realId; }) : noCombo.concat([realId]);
      }
      newSel = result;
      return Object.assign({}, c, { selectedAlbums: result });
    });
    albumErrors[childId] = "";
    if (newSel.length > 0) albumsExpanded[childId] = false;
    renderStep3();
  }

  // ── Debounce + busca ──────────────────────────────────────────────────────────
  function debounce(fn, ms) {
    var t;
    return function() {
      var args = arguments;
      clearTimeout(t);
      t = setTimeout(function(){ fn.apply(null, args); }, ms);
    };
  }

  var debouncedSearch = debounce(function(childId, name) {
    if (!name.trim() || name.trim().length < 2) {
      children = children.map(function(c){
        return c.id===childId ? Object.assign({},c,{albumResult:null,isSearching:false,selectedAlbums:[]}) : c;
      });
      updateResultArea(childId);
      return;
    }
    fetch(API + "/api/children/search?name=" + encodeURIComponent(name.trim()))
      .then(function(r){ return r.json(); })
      .then(function(data){
        children = children.map(function(c){
          return c.id===childId ? Object.assign({},c,{albumResult:data,isSearching:false,selectedAlbums:[]}) : c;
        });
      })
      .catch(function(){
        children = children.map(function(c){
          return c.id===childId ? Object.assign({},c,{albumResult:null,isSearching:false,selectedAlbums:[]}) : c;
        });
      })
      .finally(function(){ updateResultArea(childId); });
  }, 600);

  // ── Validação ─────────────────────────────────────────────────────────────────
  function validateStep1() {
    var e = { fullName: "", email: "", telefone: "" };
    var ok = true;
    if (!customer.fullName.trim()) { e.fullName = "Nome completo é obrigatório"; ok = false; }
    else if (customer.fullName.trim().length < 3) { e.fullName = "Nome deve ter pelo menos 3 caracteres"; ok = false; }
    if (!customer.email.trim()) { e.email = "E-mail é obrigatório"; ok = false; }
    else if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(customer.email)) { e.email = "E-mail inválido"; ok = false; }
    else if (emailCheckState === "invalid") { e.email = "E-mail inválido ou domínio inexistente"; ok = false; }
    else if (emailCheckState === "checking") { e.email = "Verificando e-mail, aguarde..."; ok = false; }
    else if (emailCheckState === "idle") { doEmailCheck(customer.email.trim()); e.email = "Verificando e-mail..."; ok = false; }
    if (!customer.telefone.trim()) { e.telefone = "Telefone é obrigatório"; ok = false; }
    else if (selectedCountry.code === "BR" && !/^\(\d{2}\) \d{4,5}-\d{4}$/.test(customer.telefone)) { e.telefone = "Telefone inválido. Use (XX) XXXXX-XXXX"; ok = false; }
    else if (selectedCountry.code !== "BR" && customer.telefone.replace(/\D/g,"").length < 5) { e.telefone = "Número de telefone inválido"; ok = false; }
    errors = e;
    if (!ok) renderStep1();
    return ok;
  }

  function validateStep3() {
    if (children.some(function(c){ return !c.name.trim(); })) {
      alert("Por favor, preencha o nome de todas as crianças"); return false;
    }
    var errs = {};
    children.forEach(function(c){
      if (c.albumResult && c.albumResult.found && !(c.selectedAlbums||[]).length) errs[c.id] = "Selecione pelo menos um álbum";
    });
    if (Object.keys(errs).length) { albumErrors = errs; renderStep3(); return false; }
    return true;
  }

  // ── Fluxo ─────────────────────────────────────────────────────────────────────
  function updateNextBtn() {
    var lbl = $nextLbl();
    if (!lbl) return;
    lbl.textContent = "CONTINUAR";
    var backBtn = document.getElementById("tc-back-btn");
    if (backBtn) backBtn.style.display = step > 1 ? "flex" : "none";
  }

  function goStep(n) {
    step = n;
    renderHeader();
    if (n === 1) renderStep1();
    else if (n === 2) renderStep2();
    else renderStep3();
    updateNextBtn();
  }

  function fetchAlbums() {
    loadingAlbums = true;
    fetch(API + "/api/albums")
      .then(function(r){ return r.json(); })
      .then(function(j){
        if (j.success) {
          albumsAPI = j.data;
          var gravs = albumsAPI.filter(function(a){ return a.tipo === "GRAVACAO"; });
          var albumsOnlyCount = albumsAPI.filter(function(a){ return a.tipo === "ALBUM"; }).length;
          if (gravs.length > 0) {
            var p1 = parseFloat(gravs[0].priceNew || 0);
            GRAVADO_INDIVIDUAL_NENHUM = p1;
            GRAVADO_INDIVIDUAL_UM_FALTANDO = p1;
          }
          var comboGrav = gravs[albumsOnlyCount] || null;
          if (comboGrav) {
            var cgPrice = parseFloat(comboGrav.priceNew || 0);
            var cgMistoPrice = parseFloat(comboGrav.priceMistoNew || 0);
            COMBO_GRAVADO_PRICE_FULL = cgPrice;
            // "1 álbum faltando" = combo_misto (criança já tem álbum gravado) —
            // usa priceMistoNew quando configurado, senão cai no preço cheio.
            COMBO_GRAVADO_ONE_MISSING = cgMistoPrice > 0 ? cgMistoPrice : cgPrice;
          }
        }
      })
      .catch(function(e){ console.error("Erro ao buscar álbuns:", e); })
      .finally(function(){ loadingAlbums = false; });
  }

  function openModal(detail) {
    detail = detail || {};
    productName = detail.name || "Cantigas Personalizadas";
    isCombo = !!detail.combo;
    var _priceRaw = String(detail.price || "0").replace(/[^\d,\.]/g, "").replace(",", ".");
    productPrice = parseFloat(_priceRaw) || 0;
    step = 1;
    childrenCount = 0;
    customer = { fullName: "", email: "", telefone: "" };
    selectedCountry = COUNTRIES[0];
    countryDropdownOpen = false;
    countrySearch = "";
    emailCheckState = "idle";
    children = [];
    albumsAPI = []; albumErrors = {}; albumsExpanded = {}; errors = { fullName: "", email: "", telefone: "" };
    isOpen = true;
    document.getElementById("tc-modal").style.display = "";
    document.body.style.overflow = "hidden";
    renderHeader();
    renderStep1();
    updateNextBtn();
    fetchAlbums();
  }

  function closeModal() {
    isOpen = false;
    document.getElementById("tc-modal").style.display = "none";
    document.body.style.overflow = "";
  }

  // ── Eventos ───────────────────────────────────────────────────────────────────
  window.addEventListener("open-modal", function(e){ openModal(e.detail); });

  document.getElementById("tc-backdrop").onclick = function(){ closeModal(); };

  document.getElementById("tc-back-btn").onclick = function(){ if (step > 1) goStep(step - 1); };

  document.getElementById("tc-next-btn").onclick = function(){
    if (step === 1) {
      if (validateStep1()) {
        var icNameParts = (customer.fullName || "").trim().split(/\s+/);
        var icFn = icNameParts[0] || null;
        var icLn = icNameParts.slice(1).join(" ") || null;
        var icPhone = (customer.telefone || "").replace(/\D/g, "");
        if (icPhone && icPhone.indexOf("55") !== 0) icPhone = "55" + icPhone;
        // [TC-CAPI 2026-06] Advanced matching — fbevents.js hasheia no browser.
        try {
          if (window.fbq) {
            var am = { country: "br" };
            if (customer.email) am.em = customer.email.trim().toLowerCase();
            if (icPhone) { am.ph = icPhone; am.external_id = icPhone; }
            if (icFn) am.fn = String(icFn).toLowerCase();
            if (icLn) am.ln = String(icLn).toLowerCase();
            window.fbq("init", "2321147791624359", am);
          }
        } catch (e) {}
        // [TC-CAPI 2026-06] Lead — captura de contato (Step 1). InitiateCheckout dispara no Step 3.
        var _leadEventId = "Lead_" + Date.now();
        var _leadFbqParams = {
          currency: "BRL", value: 1,
          geo: "BR", country: "br",
          page_title: document.title, session_id: getSessionId(), event_source_url: location.href
        };
        if (window.fbq) {
          var _lTec = window._fbTestEventCode;
          var _lFbqOpts = { eventID: _leadEventId };
          if (_lTec) _lFbqOpts.test_event_code = _lTec;
          window.fbq("track", "Lead", _leadFbqParams, _lFbqOpts);
        }
        if (window.ttq) { window.ttq.track("Lead", { content_name: productName, currency: "BRL" }); }
        try {
          var _lup2 = new URLSearchParams(location.search);
          var _lutm2 = {};
          ["utm_source","utm_medium","utm_campaign","utm_term","utm_content"].forEach(function(k){ var v = _lup2.get(k); if (v) _lutm2[k] = v; });
          var _lfc2 = _lup2.get("fbclid");
          var _lattr2 = null;
          if (_lfc2 || _lutm2.utm_source) {
            var _lrd2 = {};
            if (_lfc2) _lrd2.fbclid = _lfc2;
            if (_lutm2.utm_source) _lrd2.utm_source = _lutm2.utm_source;
            _lattr2 = { source: _lfc2 ? "meta" : _lutm2.utm_source, reason: _lfc2 ? "fbclid" : "utm_source", decided_at: new Date().toISOString(), raw_data: _lrd2, via: "url" };
          }
          fetch(API + "/api/track", {
            method: "POST", headers: { "Content-Type": "application/json" }, keepalive: true,
            body: JSON.stringify({
              event_name: "Lead", event_id: _leadEventId,
              value: 1, currency: "BRL",
              lead: { name: (customer.fullName || "").trim() || undefined, email: customer.email ? customer.email.trim().toLowerCase() : undefined, phone: icPhone ? "+" + icPhone : undefined },
              children: [],
              fbp: (document.cookie.match(/(?:^| )_fbp=([^;]+)/) || [])[1] || null,
              fbc: getFbc(), user_agent: navigator.userAgent,
              event_source_url: location.href, referrer: document.referrer || null,
              page_title: document.title || null,
              page_referrer: document.referrer || null,
              source_platform: "meta",
              viewport_width: window.innerWidth,
              viewport_height: window.innerHeight,
              session_id: icPhone || getSessionId(), geo: "BR",
              utm: Object.keys(_lutm2).length ? _lutm2 : undefined,
              attribution: _lattr2 || undefined,
              em: customer.email ? customer.email.trim().toLowerCase() : null,
              ph: icPhone || null, fn: icFn, ln: icLn
            })
          }).catch(function(err){ console.error("[Lead] fetch CAPI falhou:", err); });
        } catch (e) { console.error("[Lead] erro no bloco Lead:", e); }
        goStep(2);
      }
    } else if (step === 2) {
      if (childrenCount > 0) {
        var newChildren = [];
        for (var i = 0; i < childrenCount; i++) {
          newChildren.push({ id: String(Date.now() + i), name: "", albumResult: null, isSearching: false, selectedAlbums: [] });
        }
        children = newChildren;
        albumErrors = {};
        albumsExpanded = {};
        goStep(3);
      }
    } else {
      if (validateStep3()) {
        var gravacaoItems = [];
        var childrenClean = children.map(function(c) {
          var sel = c.selectedAlbums || [];
          var foundCount = (c.albumResult && c.albumResult.found) ? (c.albumResult.albums || []).length : 0;
          var displayName = (c.albumResult && c.albumResult.display_name) || c.name;
          var cleanSel = [];
          sel.forEach(function(key) {
            if (key === "personalizado:combo") {
              var cgAlbumSel = getComboGravacao();
              gravacaoItems.push({
                albumId: cgAlbumSel ? cgAlbumSel.id : "combo_gravacao",
                childName: displayName,
                name: getComboGravacaoName(),
                price: foundCount >= 1 ? COMBO_GRAVADO_ONE_MISSING : COMBO_GRAVADO_PRICE_FULL
              });
            } else if (key.startsWith("personalizado:")) {
              var origId = key.slice(14);
              var origAlbum = getAlbumById(origId);
              gravacaoItems.push({
                albumId: origId,
                childName: displayName,
                name: (origAlbum ? origAlbum.name : "Álbum") + " Gravação",
                price: foundCount >= 1 ? GRAVADO_INDIVIDUAL_UM_FALTANDO : GRAVADO_INDIVIDUAL_NENHUM
              });
            } else {
              cleanSel.push(key);
            }
          });
          return Object.assign({}, c, { selectedAlbums: cleanSel });
        });
        // [TC-CAPI 2026-06] InitiateCheckout — Step 3, álbuns selecionados, valor real
        try {
          var ic3Phone = (customer.telefone || "").replace(/\D/g, "");
          if (ic3Phone && ic3Phone.indexOf("55") !== 0) ic3Phone = "55" + ic3Phone;
          var ic3EventId = "IC_" + Date.now();
          var ic3Parts = (customer.fullName || "").trim().split(/\s+/);
          var ic3Fn = ic3Parts[0] || null;
          var ic3Ln = ic3Parts.slice(1).join(" ") || null;
          var ic3Total = parseFloat(calcTotal());
          // monta items reais: álbuns digitais + gravações
          var ic3Items = [];
          childrenClean.forEach(function(c) {
            (c.selectedAlbums || []).forEach(function(albumId) {
              var a = getAlbumById(albumId);
              ic3Items.push({ id: albumId, name: a ? a.name : albumId, quantity: 1, price: a ? parseFloat(a.priceNew) : 0 });
            });
          });
          gravacaoItems.forEach(function(g) {
            ic3Items.push({ id: g.albumId, name: g.name, quantity: 1, price: g.price });
          });
          // children no formato do payload N8N
          var ic3Children = children.map(function(c, idx) {
            var sel = c.selectedAlbums || [];
            var foundCount = (c.albumResult && c.albumResult.found) ? (c.albumResult.albums || []).length : 0;
            return { index: idx + 1, name: (c.albumResult && c.albumResult.display_name) || c.name, product: isComboGravadoSelected(sel) ? "combo" : "album", type: isComboGravadoSelected(sel) ? "gravado" : "digital", price: calcSubtotal(sel, foundCount) };
          });
          var ic3Ids = ic3Items.map(function(i) { return i.id; });
          var ic3Contents = ic3Items.map(function(i) { return { content_id: i.id, quantity: 1, price: i.price, name: i.name }; });
          // UTM + attribution
          var ic3Up = new URLSearchParams(location.search);
          var ic3Utm = {};
          ["utm_source","utm_medium","utm_campaign","utm_term","utm_content"].forEach(function(k){ var v = ic3Up.get(k); if (v) ic3Utm[k] = v; });
          var ic3Fc = ic3Up.get("fbclid");
          var ic3Attr = null;
          if (ic3Fc || ic3Utm.utm_source) {
            var ic3Rd = {};
            if (ic3Fc) ic3Rd.fbclid = ic3Fc;
            if (ic3Utm.utm_source) ic3Rd.utm_source = ic3Utm.utm_source;
            ic3Attr = { source: ic3Fc ? "meta" : ic3Utm.utm_source, reason: ic3Fc ? "fbclid" : "utm_source", decided_at: new Date().toISOString(), raw_data: ic3Rd, via: "url" };
          }
          // browser pixel
          if (window.fbq) {
            var _icTec = window._fbTestEventCode;
            var _icFbqOpts = { eventID: ic3EventId };
            if (_icTec) _icFbqOpts.test_event_code = _icTec;
            window.fbq("track", "InitiateCheckout", {
              content_name: productName, content_category: "musica_digital", content_type: "product",
              currency: "BRL", value: ic3Total, num_items: ic3Items.length,
              content_ids: ic3Ids, geo: "BR", session_id: getSessionId(), event_source_url: location.href
            }, _icFbqOpts);
          } else {
            console.warn("[IC] window.fbq não definido — pixel não disparou");
          }
          if (window.ttq) { window.ttq.track("InitiateCheckout", { content_name: productName, currency: "BRL", value: ic3Total, event_id: ic3EventId }); }
          // CAPI
          fetch(API + "/api/track", {
            method: "POST", headers: { "Content-Type": "application/json" }, keepalive: true,
            body: JSON.stringify({
              event_name: "InitiateCheckout", event_id: ic3EventId,
              lead: { name: (customer.fullName || "").trim() || undefined, email: customer.email ? customer.email.trim().toLowerCase() : undefined, phone: ic3Phone ? "+" + ic3Phone : undefined },
              checkout: { currency: "BRL", value: ic3Total, items: ic3Items },
              content_ids: ic3Ids, contents: ic3Contents, children: ic3Children,
              value: ic3Total, currency: "BRL",
              content_name: productName,
              content_category: "musica_digital",
              content_type: "product",
              num_items: ic3Items.length,
              fbp: (document.cookie.match(/(?:^| )_fbp=([^;]+)/) || [])[1] || null,
              fbc: getFbc(), user_agent: navigator.userAgent,
              event_source_url: location.href, referrer: document.referrer || null,
              session_id: ic3Phone || getSessionId(), geo: "BR",
              utm: Object.keys(ic3Utm).length ? ic3Utm : undefined,
              attribution: ic3Attr || undefined,
              em: customer.email ? customer.email.trim().toLowerCase() : null,
              ph: ic3Phone || null, fn: ic3Fn, ln: ic3Ln
            })
          }).catch(function(err){ console.error("[IC] fetch CAPI falhou:", err); });
        } catch (e) { console.error("[IC] erro no bloco InitiateCheckout:", e); }
        var telefoneComCodigo = selectedCountry.code === "BR"
          ? customer.telefone
          : selectedCountry.dial + customer.telefone.replace(/\D/g,"");
        localStorage.setItem("orderData", JSON.stringify({
          customerData: Object.assign({}, customer, { telefone: telefoneComCodigo }), children: childrenClean, albumsAPI: albumsAPI,
          productName: productName, total: calcTotal(), isCombo: isCombo,
          gravacaoItems: gravacaoItems,
          tracking: {
            fbp: getCookie("_fbp"),
            fbc: getFbc(),
            user_agent: navigator.userAgent,
            event_source_url: location.href,
            referrer: document.referrer || null,
            session_id: getSessionId()
          }
        }));
        closeModal();
        window.location.href = "/pagamento";
      }
    }
  };

  document.addEventListener("keydown", function(e){
    if (e.key === "Escape" && isOpen) closeModal();
  });
})();
</script>