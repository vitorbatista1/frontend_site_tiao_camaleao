---
const API_URL = import.meta.env.PUBLIC_API_URL ?? "";

interface RawCombo {
  id: string;
  name: string;
  priceOld: string | number;
  priceNew: string | number;
}

interface Combo {
  id: string;
  name: string;
  priceOld: number;
  priceNew: number;
}

interface Props {
  campaignId: string;
  comboSrc: string;
  comboSrcset: string;
}

const { campaignId, comboSrc, comboSrcset } = Astro.props;

let combo: Combo | null = null;

try {
  const res = await fetch(
    `${API_URL}/api/albums/combos?campanha=${campaignId}&tipo=COMBO`
  );

  const json = await res.json();

  const raw: RawCombo = Array.isArray(json.data)
    ? json.data[0]
    : json.data;

  if (raw) {
    combo = {
      id: raw.id,
      name: raw.name,
      priceOld: Number(raw.priceOld),
      priceNew: Number(raw.priceNew),
    };
  }
} catch {}

function fmt(v: number) {
  return v.toFixed(2).replace(".", ",");
}

const ITEMS = [
  "O dobro de cantigas personalizadas por mais R$ 20",
  "Parabéns pra Você autoral com o nome da criança.",
  "Ebook* com ilustrações e cifras de todas as cantigas.",
  "Total de 15 cantigas personalizadas**.",
];

const CONFIRMACOES = [
  "Álbum 1",
  "Álbum 2",
  "Parabéns pra Você",
  "Ebook*",
];
---

<section
  class="py-20 bg-[#f8e505]"
  style="content-visibility: auto; contain-intrinsic-size: 0 700px;"
>
  <div class="container">

    <h2 class="text-center text-4xl md:text-6xl font-black text-slate-500 mb-12 tracking-tight">
      Promoção
    </h2>

    <div class="relative mx-auto max-w-4xl rounded-[3rem] bg-white p-6 pt-14 md:p-10 md:pt-14 combo-card">

      <div class="absolute -top-6 left-1/2 -translate-x-1/2 md:left-28 md:translate-x-0">
        <span class="badge-pulse rounded-2xl border-2 border-dashed border-slate-500 bg-[#FFD700] px-6 py-2.5 md:px-10 md:py-4 text-base md:text-2xl font-black uppercase tracking-tight text-slate-700 shadow-lg whitespace-nowrap inline-block">
          Mais vendido
        </span>
      </div>

      <div class="text-center">

        <h3 class="text-3xl text-slate-700 md:text-5xl font-bold">
          Combo Especial
        </h3>

        <div class="w-full md:pr-36">

          <div class="my-10 flex flex-col md:flex-row justify-center md:justify-end items-center md:items-start gap-8">

            {/* Imagem */}
            <div class="flex-shrink-0">
              <img
                src={comboSrc}
                srcset={comboSrcset}
                sizes="(max-width: 768px) 260px, 380px"
                alt="Combo Especial"
                width={500}
                height={500}
                class="w-64 md:w-80 object-contain mx-auto md:mx-0"
                loading="lazy"
                decoding="async"
              />
            </div>

            {/* Itens + preço ao lado direito */}
            <div class="flex-shrink-0 text-left w-full md:w-auto">

              {/* itens + linha laranja contidos na mesma largura */}
              <div class="inline-flex flex-col mt-10 mb-5">
                <div class="space-y-3">
                  {CONFIRMACOES.map((item) => (
                    <div class="flex items-start gap-3">
                      <span class="text-green-500 font-black text-2xl leading-snug flex-shrink-0">✓</span>
                      <span class="text-slate-700 font-semibold text-xl leading-snug">{item.replace("✓ ", "")}</span>
                    </div>
                  ))}
                </div>

                {/* Linha laranja — mesma largura do bloco acima */}
                <hr class="border-t-[3px] border-orange-400 mt-5 w-full" />
              </div>

              {/* Preços */}
              <div class="flex flex-col gap-0.5">
                <span
                  class="text-base font-bold text-slate-400 line-through"
                  style="text-decoration-color: #fca5a5;"
                >
                  de R$ {combo && combo.priceOld > 0 ? Math.round(combo.priceOld) : "90"}
                </span>
                <span class="text-3xl md:text-4xl font-black text-red-600 leading-tight">
                  <small class="text-xl font-bold not-italic">por R$</small>{" "}
                  {combo ? Math.round(combo.priceNew) : "74"}
                </span>
              </div>

            </div>
          </div>

          <ul class="inline-block space-y-3 text-left text-lg font-bold text-slate-600 mb-10">
          {ITEMS.map((item) => (
            <li class="flex items-start gap-3">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="3"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="mt-1 h-6 w-6 flex-shrink-0 text-green-500"
                aria-hidden="true"
              >
                <polyline points="20 6 9 17 4 12" />
              </svg>
              <span>{item}</span>
            </li>
          ))}
        </ul>

        </div>{/* /max-w-2xl mx-auto */}

        <p class="text-sm font-bold text-green-800 text-left max-w-md md:max-w-2xl mx-auto mt-2 leading-relaxed bg-green-100 rounded-xl px-4 py-3 border border-green-200">
          * Ebook – livro digital que pode ser baixado, compartilhado e impresso.<br />
          ** Total de cantigas personalizadas: 7 álbum 1 + 7 álbum 2 + Parabéns pra Você.
        </p>

        <div class="flex flex-col items-center gap-4 mt-6">
          {combo ? (
            <button
              type="button"
              class="btn-red-rounded"
              data-buy
              data-buy-name={combo.name}
              data-buy-price={`R$ ${fmt(combo.priceNew)}`}
              data-buy-combo
            >
              COMPRAR AGORA
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="h-5 w-5"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <circle cx="9" cy="21" r="1"></circle>
                <circle cx="20" cy="21" r="1"></circle>
                <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
              </svg>
            </button>
          ) : (
            <a
              href="#produtos"
              class="btn-red-rounded"
            >
              COMPRAR AGORA
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="h-5 w-5"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <circle cx="9" cy="21" r="1"></circle>
                <circle cx="20" cy="21" r="1"></circle>
                <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
              </svg>
            </a>
          )}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .combo-card {
    box-shadow: 0 8px 32px -8px rgba(0, 0, 0, 0.18);
  }
</style>