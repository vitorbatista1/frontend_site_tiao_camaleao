---
const API_URL = import.meta.env.PUBLIC_API_URL ?? "";

interface RawCombo {
  id: string;
  name: string;
  priceOld: string | number;
  priceNew: string | number;
}

interface Combo {
  id: string;
  name: string;
  priceOld: number;
  priceNew: number;
}

interface Props {
  campaignId: string;
  comboSrc: string;
  comboSrcset: string;
}

const { campaignId, comboSrc, comboSrcset } = Astro.props;

let combo: Combo | null = null;

try {
  const res = await fetch(
    `${API_URL}/api/albums/combos?campanha=${campaignId}&tipo=COMBO`
  );

  const json = await res.json();

  const raw: RawCombo = Array.isArray(json.data)
    ? json.data[0]
    : json.data;

  if (raw) {
    combo = {
      id: raw.id,
      name: raw.name,
      priceOld: Number(raw.priceOld),
      priceNew: Number(raw.priceNew),
    };
  }
} catch {}

function fmt(v: number) {
  return v.toFixed(2).replace(".", ",");
}

const ITEMS = [
  "Um super desconto no segundo álbum",
  "Total de 15 cantigas personalizadas",
  "Parabéns pra Você autoral com o nome da criança",
  "Ebook ilustrado com letras e cifras das cantigas",
];

const CONFIRMACOES = [
  "✓ Pagamento 100% seguro",
  "✓ Acesso vitalício",
  "✓ Suporte exclusivo",
  "✓ Garantia de 7 dias",
  "✓ Atualizações gratuitas",
  "✓ Certificado de conclusão",
];
---

<section
  class="py-20 bg-[#f8e505]"
  style="content-visibility: auto; contain-intrinsic-size: 0 700px;"
>
  <div class="container">

    <h2 class="text-center text-4xl md:text-6xl font-black text-slate-500 mb-12 tracking-tight">
      Promoção
    </h2>

    <div class="relative mx-auto max-w-4xl rounded-[3rem] bg-white p-8 pt-16 md:p-16 combo-card">

      <div class="absolute -top-6 left-1/2 -translate-x-1/2 md:left-28 md:translate-x-0">
        <span class="rounded-2xl border-2 border-dashed border-slate-500 bg-[#FFD700] px-6 py-2.5 md:px-10 md:py-4 text-sm md:text-xl font-black uppercase tracking-tight text-slate-700 shadow-lg whitespace-nowrap">
          Mais vendido
        </span>
      </div>

      <div class="text-center">

        <h3 class="text-3xl text-slate-700 md:text-5xl font-bold">
          Combo Especial
        </h3>

        <div class="my-10 flex flex-col md:flex-row justify-center items-start gap-8">
          
          {/* Imagem */}
          <div class="flex-shrink-0">
            <img
              src={comboSrc}
              srcset={comboSrcset}
              sizes="(max-width: 768px) 260px, 380px"
              alt="Combo Especial"
              width={500}
              height={500}
              class="w-64 md:w-80 mx-auto object-contain"
              loading="lazy"
              decoding="async"
            />
          </div>

          {/* Preço e Confirmações ao lado direito */}
          <div class="flex-1 text-left">
            {combo && (
              <div class="flex flex-col gap-1 font-bold mb-6">
                {combo.priceOld > 0 && (
                  <span class="text-lg text-slate-400 line-through">
                    de R$ {fmt(combo.priceOld)}
                  </span>
                )}

                <span class="text-4xl md:text-5xl font-black text-red-600 italic leading-tight">
                  <small class="text-lg not-italic">por R$</small>{" "}
                  {fmt(combo.priceNew)}
                </span>
              </div>
            )}

            {/* Bloco de Confirmações */}
            <div class="bg-green-50 rounded-2xl p-4 border border-green-200">
              <h4 class="text-green-800 font-bold text-lg mb-3 flex items-center gap-2">
                <svg 
                  xmlns="http://www.w3.org/2000/svg" 
                  width="20" 
                  height="20" 
                  viewBox="0 0 24 24" 
                  fill="none" 
                  stroke="currentColor" 
                  stroke-width="2" 
                  stroke-linecap="round" 
                  stroke-linejoin="round"
                >
                  <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
                  <polyline points="22 4 12 14.01 9 11.01"/>
                </svg>
                Você receberá:
              </h4>
              <div class="grid grid-cols-1 md:grid-cols-2 gap-2">
                {CONFIRMACOES.map((confirmacao) => (
                  <div class="flex items-center gap-2 text-sm text-green-700">
                    <span class="text-green-500 font-bold">✓</span>
                    <span>{confirmacao.replace("✓ ", "")}</span>
                  </div>
                ))}
              </div>
            </div>
          </div>
        </div>

        <ul class="inline-block space-y-3 text-left text-lg font-bold text-slate-600 mb-10">
          {ITEMS.map((item) => (
            <li class="flex items-start gap-3">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="3"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="mt-1 h-6 w-6 flex-shrink-0 text-green-500"
                aria-hidden="true"
              >
                <polyline points="20 6 9 17 4 12" />
              </svg>
              <span>{item}</span>
            </li>
          ))}
        </ul>

        <div class="flex flex-col items-center gap-4">
          {combo ? (
            <button
              type="button"
              class="btn-red-rounded"
              data-buy
              data-buy-name={combo.name}
              data-buy-price={`R$ ${fmt(combo.priceNew)}`}
              data-buy-combo
            >
              COMPRAR AGORA
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="h-5 w-5"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <circle cx="9" cy="21" r="1"></circle>
                <circle cx="20" cy="21" r="1"></circle>
                <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
              </svg>
            </button>
          ) : (
            <a
              href="#produtos"
              class="btn-red-rounded"
            >
              COMPRAR AGORA
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="h-5 w-5"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <circle cx="9" cy="21" r="1"></circle>
                <circle cx="20" cy="21" r="1"></circle>
                <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
              </svg>
            </a>
          )}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .combo-card {
    box-shadow: 0 8px 32px -8px rgba(0, 0, 0, 0.18);
  }
</style>