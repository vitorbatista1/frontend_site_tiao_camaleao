---
import { Image } from "astro:assets";
import "../styles/global.css";
import FaqAccordion from "../components/FaqAccordion.tsx";
import ModalController from "../components/ModalController.tsx";
import {
  Music,
  Heart,
  Play,
  Check,
  Lock,
  Mail,
  Phone,
  Instagram,
  ShoppingCart,
  Gift,
  MessageCircle,
} from "../components/Icons.tsx";

import heroChildren from "../assets/hero-children.jpg";
import chameleon from "../assets/chameleon-mascot.png";
import kidHeadphones from "../assets/kid-headphones.png";
import album1 from "../assets/album-1.jpg";
import album2 from "../assets/album-2.jpg";
import musician from "../assets/musician.jpg";
import familyCollage from "../assets/family-collage.jpg";
import studio from "../assets/studio.jpg";

import rostoFeliz from "../assets/benefits/emoji_feliz.png";
import coracao from "../assets/benefits/coracao.png";
import globo from "../assets/benefits/globo.png";
import jogoPeca from "../assets/benefits/jogo_peca.png";
import nuvemCoracao from "../assets/benefits/nuvem_coracao.png";
import nuvems from "../assets/benefits/nuvems.png";

const benefits = [
  {
    icon: rostoFeliz,
    title: "A criança se reconhece",
    text: "Quando a criança ouve o próprio nome na música, os olhinhos brilham. Um momento de alegria que você vai querer registrar.",
  },
  {
    icon: globo,
    title: "Para quem está longe, mas quer manter o Brasil por perto",
    text: "Para famílias fora do Brasil: as cantigas mantêm o vínculo, a língua, o carinho e as memórias vivas, mesmo à distância.",
  },
  {
    icon: coracao,
    title: "Uma lembrança que fica para sempre",
    text: "Um dia essa criança vai crescer, ouvir essa cantiga… e lembrar do carinho de quem deu esse presente.",
  },
  {
    icon: nuvemCoracao,
    title: "Um presente diferente de tudo que voce ja comprou",
    text: "Brinquedo passa. Roupa deixa de servir. Esse presente vira memória, afeto e história de família.",
  },
  {
    icon: jogoPeca,
    title: "Aprender brincando",
    text: "Enquanto se diverte, a criança aprende a ouvir, esperar e prestar atenção.",
  },
  {
    icon: nuvems,
    title: "Estimula a fala",
    text: "A música ajuda a criança a reconhecer sons, palavras e a se comunicar melhor naturalmente.",
  },
];

const testimonialPrints = [
  { id: 1, label: "Print depoimento 1" },
  { id: 2, label: "Print depoimento 2" },
  { id: 3, label: "Print depoimento 3" },
];

const album1Tracks = [
  "Apresentação",
  "Ciranda Cirandinha — personalizada",
  "Bote Aqui o Seu Pezinho — personalizada",
  "O Sapo Não Lava o Pé",
  "Alecrim Dourado — personalizada",
  "10 Indiozinhos — personalizada",
  "Cai Cai Balão",
  "Marcha Soldado — personalizada",
  "Samba Lelê — personalizada",
  "Dona Aranha",
  "Fonte do Tororó — personalizada",
];

const album2Tracks = [
  "Apresentação",
  "Sabiá na Gaiola — personalizada",
  "Sapo Jururu — personalizada",
  "Formiguinha",
  "Peixe Vivo — personalizada",
  "Meu Limão, Meu Limoeiro — personalizada",
  "Pai Francisco — personalizada",
  "Escravos de Jó",
  "Pirulito que Bate-Bate — personalizada",
  "Se Essa Rua Fosse Minha — personalizada",
];

const albums = [
  { img: album1, title: "Álbum 1", tracks: album1Tracks, audio: "", price: "R$ 47,00" },
  { img: album2, title: "Álbum 2", tracks: album2Tracks, audio: "", price: "R$ 47,00" },
];

const year = new Date().getFullYear();
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Tião Camaleão – Cantigas com o nome da criança</title>
    <meta
      name="description"
      content="Cantigas infantis personalizadas com o nome da sua criança. Mais de 2.000 nomes gravados em estúdio. Presente único que vira memória de família."
    />
  </head>
  <body>
    <ModalController client:load />

    <div class="min-h-screen overflow-hidden bg-background">
      <!-- Top strip -->
      <div
        class="bg-accent py-2 text-center text-sm font-bold uppercase tracking-wider text-accent-foreground"
      >
        <span aria-hidden="true">💚</span> Desde 2013 encantando famílias <span
          aria-hidden="true">💚</span
        >
      </div>

      <!-- HERO -->
      <header
        class="relative isolate overflow-hidden"
        style={{ background: "white" }}
      >
        <div
          class="container relative z-10 grid items-center gap-10 py-14 md:grid-cols-2 md:py-24"
        >
          <div>
            <p
              class="mb-3 text-sm font-extrabold uppercase tracking-widest text-grape"
            >
              Um jeito especial de marcar a infância
            </p>
            <div class="relative inline-block">
              <h1
                class="text-5xl leading-[1.05] text-foreground md:text-6xl lg:text-7xl"
              >
                Cantigas com o<br />
                <span class="relative inline-block">
                  <span class="relative z-10 text-primary">nome da criança</span>
                  <!-- Imagem decorativa atrás do texto -->
                  <img 
                    src="https://cdn-icons-png.flaticon.com/512/2920/2920247.png"
                    alt=""
                    class="absolute -top-6 -right-8 h-14 w-14 opacity-30 md:-top-8 md:-right-10 md:h-20 md:w-20 rotate-12"
                    loading="lazy"
                    aria-hidden="true"
                  />
                  <img 
                    src="https://cdn-icons-png.flaticon.com/512/616/616490.png"
                    alt=""
                    class="absolute -bottom-5 -left-6 h-10 w-10 opacity-25 md:-bottom-6 md:-left-8 md:h-14 md:w-14 -rotate-12"
                    loading="lazy"
                    aria-hidden="true"
                  />
                  <img 
                    src="https://cdn-icons-png.flaticon.com/512/1995/1995572.png"
                    alt=""
                    class="absolute top-1/2 -right-10 h-8 w-8 opacity-20 md:-right-12 md:h-10 md:w-10"
                    loading="lazy"
                    aria-hidden="true"
                  />
                </span>
              </h1>
            </div>
            <p class="mt-5 max-w-md text-lg text-foreground/80">
              A maioria dos presentes passa… <strong>esse fica!</strong> Um abraço
              sonoro que vira memória de família.
            </p>
            <div class="mt-7 flex flex-wrap gap-4">
              <a href="#produtos" class="btn-pop btn-coral" data-buy data-buy-name="Cantigas Personalizadas" data-buy-price="R$ 47,00">Quero comprar</a>
              <a href="#amostra" class="btn-pop btn-green">
                <Play className="h-4 w-4" /> Pedir amostra grátis
              </a>
            </div>
          </div>
          <div class="relative">
            <div
              class="relative mx-auto aspect-square w-full max-w-md overflow-hidden rounded-[2.5rem] border-8 border-card shadow-[var(--shadow-card)]"
            >
              <Image
                src={heroChildren}
                alt="Crianças sorrindo enquanto cantam cantigas personalizadas"
                width={1280}
                height={960}
                class="h-full w-full object-cover"
              />
            </div>
            <Image
              src={chameleon}
              alt=""
              aria-hidden="true"
              width={768}
              height={768}
              class="float-slow absolute -bottom-6 -left-6 hidden h-40 w-40 md:block"
            />
            <Music
              className="absolute -right-2 top-6 h-10 w-10 text-coral wiggle"
            />
            <Music
              className="absolute -left-4 top-1/3 h-8 w-8 text-grape wiggle"
            />
          </div>
        </div>
      </header>

      <!-- GREEN BAND -->
      <section
        class="relative py-16"
        style={{ background: "var(--gradient-grass)" }}
      >
        <div class="container grid items-center gap-10 md:grid-cols-2">
          <div class="relative mx-auto w-full max-w-sm">
            <div
              class="overflow-hidden rounded-[2rem] border-8 border-accent shadow-[var(--shadow-card)]"
            >
              <Image
                src={kidHeadphones}
                alt="Criança ouvindo cantigas com fone amarelo"
                width={800}
                height={800}
                class="h-full w-full object-cover"
                loading="lazy"
              />
            </div>
            <Music
              className="absolute -left-6 top-4 h-10 w-10 text-accent wiggle"
            />
          </div>
          <div class="text-primary-foreground">
            <h2 class="text-4xl md:text-5xl">
              Um presente para ouvir hoje<br />
              e lembrar para sempre!
            </h2>
            <p class="mt-4 max-w-md text-lg text-primary-foreground/90">
              As cantigas chegam por download em minutos. É só apertar o play e
              ver os olhinhos brilharem.
            </p>
            <a href="#produtos" class="btn-pop btn-sun mt-7" data-buy data-buy-name="Cantigas Personalizadas" data-buy-price="R$ 47,00">Quero ouvir</a>
          </div>
        </div>
      </section>

      <!-- SAMPLE - Free -->
      <section
        id="amostra"
        class="relative py-16"
        style={{ background: "hsl(var(--secondary))" }}
      >
        <div class="container grid items-center gap-10 md:grid-cols-2">
          <div class="text-secondary-foreground">
            <p
              class="mb-2 text-sm font-extrabold uppercase tracking-widest text-accent"
            >
              Veja a reação quando a
            </p>
            <h2 class="text-4xl md:text-5xl">
              Criança ouve o próprio<br />nome na música
            </h2>
            <p class="mt-4 max-w-md text-lg text-secondary-foreground/90">
              Quer ver a reação da SUA CRIANÇA? Clique no botão abaixo e receba
              uma cantiga gratuita.
            </p>
            <a href="#contato" class="btn-pop btn-green mt-7">
              <Gift className="h-4 w-4" /> Pedir amostra grátis
            </a>
          </div>
          <div
            class="relative mx-auto aspect-video w-full max-w-md overflow-hidden rounded-[2rem] border-8 border-card shadow-[var(--shadow-card)]"
          >
            <div class="absolute inset-0 bg-gradient-to-br from-grape to-coral">
            </div>
            <button
              type="button"
              aria-label="Reproduzir vídeo"
              class="absolute inset-0 flex items-center justify-center transition-transform hover:scale-105"
            >
              <span
                class="grid h-20 w-20 place-items-center rounded-full bg-card text-coral shadow-[var(--shadow-button)]"
              >
                <Play className="h-9 w-9 fill-current" />
              </span>
            </button>
          </div>
        </div>
      </section>

      <!-- BENEFITS -->
      <section class="bg-gray-100 py-20">
        <div class="container">
          <p
            class="text-center text-lg font-extrabold uppercase tracking-widest text-gray-400"
          >
            POR QUE AS FAMÍLIAS AMAM
          </p>
          <h2 class="mt-2 text-center text-4xl text-gray-600 md:text-5xl">
            Muito mais que cantigas
          </h2>
          <div class="mt-12 mx-auto max-w-5xl">
            <div class="grid gap-6 grid-cols-1 md:grid-cols-2">
              {
                benefits.map(({ icon, title, text }) => (
                  <article
                    class="card-pop border-2 border-border rounded-2xl transition-all hover:scale-[1.02] relative"
                    style={{ backgroundColor: "#6ab248" }}
                  >
                    <div class="flex justify-center -mt-14 mb-2">
                      <Image
                        src={icon}
                        alt=""
                        class="h-32 w-32 md:h-36 md:w-36 object-contain drop-shadow-xl"
                        loading="lazy"
                      />
                    </div>
                    <h3 class="text-3xl font-bold text-white mb-4 text-center mt-2">
                      {title}
                    </h3>
                    <p class="text-base text-white/90 leading-relaxed text-justify px-6 pb-6">
                      {text}
                    </p>
                  </article>
                ))
              }
            </div>
          </div>
          <div class="mt-12 text-center">
            <a href="#produtos" class="btn-pop btn-coral" data-buy data-buy-name="Cantigas Personalizadas" data-buy-price="R$ 47,00">QUERO COMPRAR</a>
          </div>
        </div>
      </section>

      <!-- TESTIMONIALS -->
      <section class="py-20" style={{ background: "hsl(var(--secondary))" }}>
        <div class="container">
          <p
            class="text-center text-lg font-extrabold uppercase tracking-widest text-accent"
          >
            Depoimentos
          </p>
          <h2
            class="mt-2 text-center text-4xl text-secondary-foreground md:text-5xl"
          >
            De quem já viveu esse momento
          </h2>
          <p class="mt-3 text-center text-secondary-foreground/90">
            Prints reais de mensagens de famílias que receberam suas cantigas.
          </p>
          <div class="mt-12 grid gap-6 sm:grid-cols-2 md:grid-cols-3">
            {
              testimonialPrints.map((t) => (
                <article class="card-pop flex aspect-[4/5] flex-col items-center justify-center border-2 border-dashed border-primary/40 bg-muted/60 text-center">
                  <div class="mb-3 grid h-14 w-14 place-items-center rounded-2xl bg-primary/10 text-primary">
                    <MessageCircle className="h-7 w-7" />
                  </div>
                  <p class="px-4 font-bold text-foreground">{t.label}</p>
                  <p class="mt-1 px-4 text-sm text-muted-foreground">
                    Adicione aqui o screenshot do depoimento
                  </p>
                </article>
              ))
            }
          </div>
          <div class="mt-12 text-center">
            <a href="#produtos" class="btn-pop btn-coral" data-buy data-buy-name="Cantigas Personalizadas" data-buy-price="R$ 47,00">Eu também quero</a>
          </div>
        </div>
      </section>

      <!-- NAMES -->
      <section class="bg-background py-20">
        <div class="container grid items-center gap-12 md:grid-cols-2">
          <div class="relative">
            <Image
              src={chameleon}
              alt="Tião Camaleão tocando violão"
              width={768}
              height={768}
              class="float-slow mx-auto w-72 md:w-96"
              loading="lazy"
            />
            <div
              class="absolute left-4 top-2 rounded-full bg-coral px-4 py-1.5 text-sm font-bold text-coral-foreground shadow-[var(--shadow-pop)]"
            >
              Benício
            </div>
            <div
              class="absolute right-2 top-10 rounded-full bg-grape px-4 py-1.5 text-sm font-bold text-grape-foreground shadow-[var(--shadow-pop)]"
            >
              Maria Clara
            </div>
            <div
              class="absolute bottom-12 left-0 rounded-full bg-accent px-4 py-1.5 text-sm font-bold text-accent-foreground shadow-[var(--shadow-pop)]"
            >
              Dudu
            </div>
          </div>
          <div>
            <h2 class="text-4xl text-foreground md:text-5xl">
              Mais de <span class="text-primary">2.000 nomes</span><br />
              já gravados em estúdio
            </h2>
            <p class="mt-4 text-lg text-muted-foreground">
              Temos um grande acervo, incluindo nomes raros, compostos, apelidos
              e até nomes estrangeiros.
            </p>
            <div class="mt-6 rounded-2xl border-2 border-border bg-muted p-5">
              <p class="font-bold text-foreground">
                E se não tiver o nome que eu quero?
              </p>
              <p class="mt-1 text-muted-foreground">
                Sem problema! Fazemos a gravação personalizada sob encomenda,
                com entrega em até 7 dias e um pequeno acréscimo de estúdio.
              </p>
            </div>
            <a href="#produtos" class="btn-pop btn-coral mt-6" data-buy data-buy-name="Cantigas Personalizadas" data-buy-price="R$ 47,00">Quero comprar</a>
          </div>
        </div>
      </section>

      <!-- PRODUCTS -->
      <section
        id="produtos"
        class="py-20"
        style={{ background: "hsl(96 45% 50%)" }}
      >
        <div class="container">
          <h2
            class="text-center text-4xl md:text-5xl"
            style={{
              color: "hsl(0 0% 100%)",
              fontFamily: "Fredoka, sans-serif",
            }}
          >
            Nossos produtos
          </h2>
          <div class="mx-auto mt-12 grid max-w-3xl gap-6 md:grid-cols-2">
            {
              albums.map((album) => (
                <article class="rounded-3xl bg-white p-6 shadow-[0_18px_40px_-12px_rgba(0,0,0,0.25)]">
                  <div
                    class="mx-auto flex aspect-square w-full max-w-[220px] items-center justify-center rounded-2xl border-2 border-dashed text-center text-sm font-medium"
                    style={{
                      borderColor: "hsl(96 45% 50% / 0.5)",
                      background: "hsl(96 45% 50% / 0.08)",
                      color: "hsl(96 45% 35%)",
                    }}
                  >
                    Espaço para o logo
                    <br />
                    do {album.title}
                  </div>

                  <h3
                    class="mt-5 text-center text-2xl"
                    style={{
                      color: "hsl(220 35% 18%)",
                      fontFamily: "Fredoka, sans-serif",
                    }}
                  >
                    {album.title}
                  </h3>
                  <p
                    class="text-center text-2xl font-extrabold"
                    style={{ color: "hsl(0 78% 55%)" }}
                  >
                    R$ <span class="text-3xl">47,00</span>
                  </p>

                  <ol class="mt-4 space-y-1.5 text-sm">
                    {album.tracks.map((track, i) => {
                      const isPersonalized = track.includes("personalizada");
                      const [name] = track.split(" — ");
                      return (
                        <li class="flex gap-2">
                          <span
                            class="w-5 flex-shrink-0 text-right font-bold"
                            style={{ color: "hsl(199 95% 45%)" }}
                          >
                            {i + 1}
                          </span>
                          <span
                            style={{
                              color: isPersonalized
                                ? "hsl(142 70% 28%)"
                                : "hsl(220 15% 35%)",
                              fontWeight: isPersonalized ? 700 : 400,
                            }}
                          >
                            {isPersonalized ? `${name} - personalizada` : track}
                          </span>
                        </li>
                      );
                    })}
                  </ol>

                  <div
                    class="mt-4 h-px w-full"
                    style={{ background: "hsl(0 78% 55% / 0.4)" }}
                  />

                  <p
                    class="mt-3 text-center text-sm"
                    style={{ color: "hsl(220 15% 35%)" }}
                  >
                    São{" "}
                    <strong style={{ color: "hsl(0 78% 55%)" }}>
                      7 cantigas personalizadas
                    </strong>
                    <br />
                    com o nome da criança!
                  </p>

                  <a
                    href={album.audio || "#"}
                    class="mx-auto mt-4 flex w-fit items-center gap-3 rounded-2xl px-4 py-2 transition-transform hover:scale-105"
                    style={{
                      background: "hsl(48 100% 60%)",
                      boxShadow: "0 4px 0 0 hsl(35 80% 35% / 0.45)",
                    }}
                    aria-label={`Ouvir amostra do ${album.title}`}
                  >
                    <div class="text-right">
                      <p
                        class="text-xs font-bold leading-tight"
                        style={{ color: "hsl(220 35% 18%)" }}
                      >
                        Clique para ouvir
                      </p>
                    </div>
                    <span
                      class="grid h-9 w-9 place-items-center rounded-full"
                      style={{ background: "hsl(0 0% 100%)" }}
                    >
                      <Play
                        className="h-4 w-4 fill-current"
                        style={{ color: "hsl(48 100% 50%)" }}
                      />
                    </span>
                    <span class="flex items-end gap-0.5" aria-hidden="true">
                      {[8, 14, 10, 18, 12, 16, 8, 14, 10].map((h) => (
                        <span
                          class="w-0.5 rounded-full"
                          style={{
                            height: `${h}px`,
                            background: "hsl(220 35% 18%)",
                          }}
                        />
                      ))}
                    </span>
                  </a>

                  <button
                    type="button"
                    class="mt-5 flex w-full items-center justify-center gap-3 rounded-full px-6 py-3 font-bold uppercase tracking-wide text-sm transition-transform hover:-translate-y-0.5 active:translate-y-0.5"
                    style={{
                      background: "hsl(0 78% 55%)",
                      color: "hsl(0 0% 100%)",
                      boxShadow: "0 5px 0 0 hsl(0 70% 35% / 0.5)",
                    }}
                    data-buy=""
                    data-buy-name={album.title}
                    data-buy-price={album.price}
                  >
                    Comprar agora
                    <ShoppingCart className="h-4 w-4" />
                  </button>
                </article>
              ))
            }
          </div>
        </div>
      </section>

      <!-- COMBO -->
      <section class="py-20 bg-[#FFD700]">
        <div class="container">
          <h2
            class="text-center font-black text-4xl text-[#333] md:text-6xl mb-12 uppercase tracking-tighter"
          >
            Promoção combo especial
          </h2>

          <div
            class="relative mx-auto max-w-4xl rounded-[3rem] bg-white p-8 pt-16 shadow-2xl md:p-16"
          >
            <div class="absolute -top-5 left-8 md:left-12">
              <span
                class="rounded-xl border-2 border-dashed border-slate-900 bg-[#FFD700] px-6 py-2 text-sm font-black uppercase tracking-tight text-slate-900"
              >
                Mais vendido
              </span>
            </div>

            <div class="text-center">
              <h3
                class="flex flex-wrap justify-center items-center gap-2 text-2xl font-black text-slate-700 md:text-4xl"
              >
                Álbum 1 <span class="text-[#FFD700] text-4xl drop-shadow-sm"
                  >+</span
                >
                Álbum 2 <span class="text-[#FFD700] text-4xl drop-shadow-sm"
                  >+</span
                >
                Parabéns personalizado <span
                  class="text-[#FFD700] text-4xl drop-shadow-sm">+</span
                >
                Ebook
              </h3>

              <div class="my-10 flex justify-center gap-2">
                <Image
                  src={album1}
                  alt="Cantigas 1"
                  class="w-40 md:w-60 shadow-xl"
                />
                <Image
                  src={album2}
                  alt="Cantigas 2"
                  class="w-40 md:w-60 shadow-xl"
                />
              </div>

              <ul
                class="inline-block space-y-3 text-left text-lg font-bold text-slate-600"
              >
                {
                  [
                    "Um super desconto no segundo álbum",
                    "Total de 15 cantigas personalizadas",
                    "Parabéns pra Você autoral com o nome da criança",
                    "Ebook ilustrado com letras e cifras das cantigas",
                  ].map((item) => (
                    <li class="flex items-start gap-3">
                      <Check className="mt-1 h-6 w-6 flex-shrink-0 text-green-500 stroke-[3px]" />
                      <span>{item}</span>
                    </li>
                  ))
                }
              </ul>

              <div class="mt-10 flex flex-col items-center gap-4">
                <div class="flex items-center gap-4 font-bold">
                  <span class="text-xl text-slate-400 line-through"
                    >de R$ 94,00</span
                  >
                  <span class="text-5xl font-black text-red-600 italic">
                    <small class="text-2xl not-italic">por R$</small> 74,00
                  </span>
                </div>

                <button
                  type="button"
                  class="group flex items-center justify-center gap-3 rounded-full bg-red-600 px-12 py-5 text-2xl font-black uppercase text-white shadow-2xl transition-transform hover:scale-105 active:scale-95"
