    <script is:inline>
      import { initMercadoPago } from "@mercadopago/sdk-js";
      initMercadoPago(import.meta.env.PUBLIC_MP_PUBLIC_KEY);
    </script>

    <script is:inline>
      document.addEventListener("click", function (e) {
        var btn = e.target.closest("[data-buy]");
        if (!btn) return;
        e.preventDefault();
        window.dispatchEvent(
          new CustomEvent("open-modal", {
            detail: {
              name: btn.getAttribute("data-buy-name") || "Cantigas Personalizadas",
              price: btn.getAttribute("data-buy-price") || "R$ 47,00",
              combo: btn.hasAttribute("data-buy-combo"),
            },
          })
        );
      });
    </script>
