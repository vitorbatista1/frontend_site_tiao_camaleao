---
// src/pages/pagamento.astro
import Layout from '../layouts/Layout.astro';
import PaymentPage from '../components/PaymentPage.tsx';
---

<Layout title="Pagamento - Cantigas Personalizadas">
    <div class="min-h-screen bg-gradient-to-b from-blue-50 to-white py-12">
        <PaymentPage client:load />
    </div>
</Layout>

<!-- [CS+GA4 2026-08] chegou_checkout (GA4) — uma vez por carregamento real de /pagamento.
     O site é MPA (sem ViewTransitions), então este <script> de página é o ÚNICO ponto
     de disparo. No Contentsquare o /pagamento já é pageview real automático. -->
<script>
  import { trackCheckout } from "../lib/analytics-tracking";
  trackCheckout();
</script>
