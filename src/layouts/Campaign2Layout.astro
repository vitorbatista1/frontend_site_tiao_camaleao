        <script>
          // Toca/pausa o áudio ao clicar no botão de play de cada card,
          // alterna o ícone e mostra o tempo tocado / duração total.
          function fmtTime(sec: number) {
            if (!isFinite(sec) || sec < 0) sec = 0;
            const m = Math.floor(sec / 60);
            const s = Math.floor(sec % 60).toString().padStart(2, '0');
            return `${m}:${s}`;
          }

          document.querySelectorAll('[data-audio-btn]').forEach((btn) => {
            const card = btn.closest('.bg-white');
            const audio = card?.querySelector('[data-audio-el]') as HTMLAudioElement | null;
            const playIcon = btn.querySelector('[data-play-icon]');
            const pauseIcon = btn.querySelector('[data-pause-icon]');
            const timeEl = card?.querySelector('[data-audio-time]');
            if (!audio) return;

            const updateTime = () => {
              if (!timeEl) return;
              timeEl.textContent = `${fmtTime(audio.currentTime)} / ${fmtTime(audio.duration)}`;
            };

            audio.addEventListener('loadedmetadata', updateTime);
            audio.addEventListener('timeupdate', updateTime);
            audio.addEventListener('play', () => {
              playIcon?.classList.add('hidden');
              pauseIcon?.classList.remove('hidden');
            });
            audio.addEventListener('pause', () => {
              playIcon?.classList.remove('hidden');
              pauseIcon?.classList.add('hidden');
            });
            audio.addEventListener('ended', () => {
              updateTime();
            });

            btn.addEventListener('click', () => {
              if (audio.paused) {
                audio.play();
