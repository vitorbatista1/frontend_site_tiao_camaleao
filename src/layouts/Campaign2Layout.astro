<style>
  .waveform-bar {
    transition: transform 0.2s ease;
  }
  #audio-play-btn.playing .waveform-bar {
    animation: bounce 0.8s ease-in-out infinite;
  }
  #audio-play-btn.playing .waveform-bar:nth-child(odd) {
    animation-delay: 0.15s;
  }
  #audio-play-btn.playing .waveform-bar:nth-child(3n) {
    animation-delay: 0.3s;
  }
  @keyframes bounce {
    0%, 100% { transform: scaleY(0.6); }
    50% { transform: scaleY(1.3); }
  }
</style>

<script>
  const btn = document.getElementById('audio-play-btn');
  const audio = document.getElementById('audio-sample') as HTMLAudioElement;
  const playIcon = document.getElementById('play-icon');
  const pauseIcon = document.getElementById('pause-icon');

  btn?.addEventListener('click', () => {
    if (audio.paused) {
      audio.play();
      btn.classList.add('playing');
      playIcon?.classList.add('hidden');
      pauseIcon?.classList.remove('hidden');
    } else {
      audio.pause();
      btn.classList.remove('playing');
      playIcon?.classList.remove('hidden');
      pauseIcon?.classList.add('hidden');
    }
  });

  audio?.addEventListener('ended', () => {
    btn?.classList.remove('playing');
    playIcon?.classList.remove('hidden');
    pauseIcon?.classList.add('hidden');
  });
</script>














