            <script>
              const track = document.getElementById('dep-track') as HTMLElement;
              const wrapper = document.getElementById('dep-track-wrapper') as HTMLElement;
              const total = track ? track.children.length : 0;
              let current = 0;

              function syncHeight() {
                if (!wrapper || !track) return;
                const slide = track.children[current] as HTMLElement;
                if (slide && slide.offsetHeight > 0) {
                  wrapper.style.height = slide.offsetHeight + 'px';
                }
              }

              function goTo(index: number) {
                current = (index + total) % total;
                track.style.transform = `translateX(-${current * 100}%)`;
                syncHeight();
              }

              document.getElementById('dep-prev')?.addEventListener('click', () => goTo(current - 1));
              document.getElementById('dep-next')?.addEventListener('click', () => goTo(current + 1));

              track.querySelectorAll('img').forEach((img) => {
                if (!(img as HTMLImageElement).complete) {
                  img.addEventListener('load', syncHeight);
                }
              });

              syncHeight();
            </script>
