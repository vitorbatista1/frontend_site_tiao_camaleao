---
import { Image, getImage } from "astro:assets";
import "../styles/global.css";
import FaqAccordion from "../components/FaqAccordion.tsx";
import ModalController from "../components/ModalController.tsx";
import CampaignProducts from "../components/CampaignProducts.tsx";
import CampaignCombo from "../components/CampaignCombo.tsx";
import {
  Music, Heart, Play, Lock, Mail, Phone, Instagram, MessageCircle,
  Star, ChevronLeft, ChevronRight, ShoppingCart
} from "../components/Icons.tsx";

import album1Raw from "../assets/album1.png";
import album2Raw from "../assets/album2.png";

import kidHeadphones from "../../public/imagens/menino.png";
import musician from "../../public/imagens/musico_.png";
import familyCollage from "../../public/imagens/familia.png";
import studio from "../../public/imagens/studio.png";
import criancasHero from "../../public/imagens/criancas_hero.png";
import logoImg from "../../public/imagens/logo.png";
import mascoteImg from "../../public/imagens/mascote.png";
import cantorNomesImg from "../../public/imagens/cantor_nomes.png";
import tiaoDuvidaImg from "../../public/imagens/tiao_duvida.png";

import rostoFeliz from "../../public/imagens/benefits/emoji_feliz.png";
import coracao from "../../public/imagens/benefits/coracao.png";
import globo from "../../public/imagens/benefits/globo.png";
import jogoPeca from "../../public/imagens/benefits/jogo_peca.png";
import nuvemCoracao from "../../public/imagens/benefits/nuvem_coracao.png";
import nuvems from "../../public/imagens/benefits/nuvems.png";

interface Props {
  campaignId: string;
}

const { campaignId } = Astro.props;

const [album1_sm, album1_lg, album2_sm, album2_lg, heroOpt] = await Promise.all([
  getImage({ src: album1Raw, format: "webp", width: 256, height: 256 }),
  getImage({ src: album1Raw, format: "webp", width: 448, height: 448 }),
  getImage({ src: album2Raw, format: "webp", width: 256, height: 256 }),
  getImage({ src: album2Raw, format: "webp", width: 448, height: 448 }),
  getImage({ src: criancasHero, format: "webp", width: 1920 }),
]);

const album1Srcset = `${album1_sm.src} 256w, ${album1_lg.src} 448w`;
const album2Srcset = `${album2_sm.src} 256w, ${album2_lg.src} 448w`;
const albumSizes = "(max-width: 768px) 192px, 224px";

const benefits = [
  {
    icon: rostoFeliz,
    title: "A criança se reconhece",
    text: "Quando a criança ouve o próprio nome na música, os olhinhos brilham. Um momento de alegria que você vai querer registrar.",
  },
  {
    icon: globo,
    title: "Para quem está longe, mas quer manter o Brasil por perto",
    text: "Para famílias fora do Brasil: as cantigas mantêm o vínculo, a língua, o carinho e as memórias vivas, mesmo à distância.",
  },
  {
    icon: coracao,
    title: "Uma lembrança que fica para sempre",
    text: "Um dia essa criança vai crescer, ouvir essa cantiga… e lembrar do carinho de quem deu esse presente.",
  },
  {
    icon: nuvemCoracao,
    title: "Um presente diferente de tudo que você já comprou",
    text: "Brinquedo passa. Roupa deixa de servir. Esse presente vira memória, afeto e história de família.",
  },
  {
    icon: jogoPeca,
    title: "Aprender brincando",
    text: "Enquanto se diverte, a criança aprende a ouvir, esperar e prestar atenção.",
  },
  {
    icon: nuvems,
    title: "Estimula a fala",
    text: "A música ajuda a criança a reconhecer sons, palavras e a se comunicar melhor naturalmente.",
  },
];

const year = new Date().getFullYear();
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Tião Camaleão – Cantigas com o nome da criança</title>
    <meta
      name="description"
      content="Cantigas infantis personalizadas com o nome da sua criança. Mais de 2.000 nomes gravados em estúdio. Presente único que vira memória de família."
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fredoka:wght@400;500;600;700&family=Nunito:wght@400;600;700;800&display=optional" />
    <link rel="preload" as="image" href={heroOpt.src} type="image/webp" />
  </head>
  <body>
    <ModalController client:idle />

    <div class="min-h-screen overflow-x-hidden bg-background">

      <!-- TOP STRIP -->
<div
  class="py-3 md:py-5 text-center font-bold uppercase tracking-widest"
