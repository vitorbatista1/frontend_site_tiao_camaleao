    <script is:inline>
      (function () {
        var video = document.getElementById('hero-video');
        var btn = document.getElementById('hero-play-btn');
        if (video && btn) {
          btn.addEventListener('click', function () {
            video.play();
            btn.style.display = 'none';
          });
          video.addEventListener('click', function () {
            if (!video.paused) {
              video.pause();
              btn.style.display = 'flex';
            }
          });
          video.addEventListener('ended', function () {
            btn.style.display = 'flex';
          });

          var autoPlayed = false;
          new IntersectionObserver(function (entries) {
            var entry = entries[0];
            if (entry.isIntersecting) {
              if (!autoPlayed) autoPlayed = true;
              video.play().then(function () {
                btn.style.display = 'none';
              }).catch(function () {});
            } else if (autoPlayed) {
              video.pause();
              btn.style.display = 'flex';
            }
          }, { threshold: 0.5 }).observe(video);
        }
      })();
    </script>

    <script is:inline>
      (function () {
        var obs = new IntersectionObserver(function (entries) {
          entries.forEach(function (e) {
            if (e.isIntersecting) {
              e.target.classList.add('is-visible');
              obs.unobserve(e.target);
            }
          });
        }, { threshold: 0.1 });
        document.querySelectorAll('.fade-up, .fade-left, .fade-right').forEach(function (el) {
          obs.observe(el);
        });
      })();
    </script>

    <script is:inline>
      document.addEventListener("click", function (e) {
        var t = e.target;
        if (!(t instanceof Element)) return;
        var btn = t.closest("[data-buy]");
        if (!btn) return;
        e.preventDefault();
        requestAnimationFrame(function () {
          window.dispatchEvent(
            new CustomEvent("open-modal", {
              detail: {
                name: btn.dataset.buyName || "Cantigas Personalizadas",
                price: btn.dataset.buyPrice || "R$ 47,00",
                combo: btn.hasAttribute("data-buy-combo"),
              },
            })
          );
        });
      });
    </script>

    <script is:inline>
      (function () {
        function getSessionId() {
          var s = sessionStorage.getItem("tc_session");
          if (!s) { s = (crypto.randomUUID ? crypto.randomUUID() : String(Date.now())); sessionStorage.setItem("tc_session", s); }
          return s;
        }
        document.addEventListener("click", function (e) {
          var a = e.target.closest && e.target.closest("a[data-wa-track]");
          if (!a) return;
          e.preventDefault();

          var baseText = a.dataset.waText || "Olá!";
          var source = a.dataset.waSource || "whatsapp_click";
          var eventID = "lead_" + getSessionId() + "_" + Date.now();

          if (window.fbq) {
            window.fbq("track", "Lead", { content_name: source }, { eventID: eventID });
          }
          if (window.ttq) {
            window.ttq.track("Contact", { content_name: source, event_id: eventID });
          }

          // pequeno atraso para o disparo do pixel concluir antes de sair da página
          var url = a.href.split("?")[0] + "?text=" + encodeURIComponent(baseText);
          setTimeout(function () { window.open(url, "_blank", "noopener"); }, 150);
        });
      })();
    </script>
