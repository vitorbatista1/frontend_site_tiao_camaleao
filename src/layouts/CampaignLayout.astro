</div>
<!-- HERO -->
<header class="relative bg-white overflow-hidden flex flex-col" style="min-height: clamp(480px, 56vw, 650px);">
  <img
    src={heroOpt.src}
    alt=""
    aria-hidden="true"
    class="absolute bottom-0 right-0 h-[90%] md:h-full w-auto pointer-events-none select-none"
    fetchpriority="high"
    loading="eager"
  />

  <!-- Logo centralizada no topo, dentro do hero -->
  <div class="relative z-10 w-full flex justify-center pt-4 pb-2">
    <Image
      src={logoImg}
      alt="Tião Camaleão"
      widths={[256, 384, 512, 768]}
      sizes="(max-width: 768px) 256px, (max-width: 1024px) 320px, 384px"
      width={768}
      height={432}
      class="w-40 md:w-64 lg:w-80"
      style="height: auto;"
    />
  </div>

  <!-- Texto do hero -->
  <div class="relative z-10 container flex items-center flex-1 py-4 md:py-10">
    <div class="w-full max-w-[62%] sm:max-w-lg md:max-w-2xl">
      <p
        class="text-sm md:text-base font-extrabold uppercase tracking-widest mb-3"
        style="color: #888; letter-spacing: 0.14em;"
      >
        Um jeito especial de marcar a infância
      </p>

      <h1
        class="font-bold leading-tight"
        style="font-size: clamp(26px, 7vw, 88px); color: #333; line-height: 1.05;"
      >
        Cantigas com o<br />nome da criança
      </h1>

      <p
        class="mt-4 font-bold"
        style="font-size: clamp(16px, 2.5vw, 30px); color: #4caf50;"
      >
        A maioria dos presentes passa… esse fica!
      </p>

      <div class="mt-5 md:mt-10">
        <a
          href="#produtos"
          class="btn-pop inline-flex items-center gap-3 uppercase tracking-wide"
