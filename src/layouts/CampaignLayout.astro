---
import { Image, getImage } from "astro:assets";
import "../styles/global.css";
import FaqAccordion from "../components/FaqAccordion.astro";
import PlayerSection from "../components/PlayerSection.astro";
import ModalVanilla from "../components/ModalVanilla.astro";
import PixelHead from "../components/PixelHead.astro";
import CampaignProducts from "../components/CampaignProducts.tsx";
import CampaignCombo from "../components/CampaignCombo.astro";
import {
  Music, Heart, Play, Lock, Mail, Phone, Instagram, MessageCircle,
  Star, ChevronLeft, ChevronRight, ShoppingCart
} from "../components/Icons.tsx";

import kidHeadphones from "../../public/imagens/kid-headphones2.png";
import musician from "../../public/imagens/musico1.png";
import familyCollage from "../../public/imagens/familia.png";
import studio from "../../public/imagens/studio.png";
import listMusicas from "../../public/imagens/list_studio.png";
import criancasHero from "../../public/imagens/criancas_hero.png";
import logoImg from "../../public/imagens/logo.png";
import mascoteImg from "../../public/imagens/mascote.png";
import cantorNomesImg from "../../public/imagens/cantor_nomes2.png";
import tiaoDuvidaImg from "../../public/imagens/tiao_duvida.png";

import rostoFeliz from "../../public/imagens/benefits/emoji_feliz.png";
import coracao from "../../public/imagens/benefits/coracao.png";
import globo from "../../public/imagens/benefits/globo.png";
import jogoPeca from "../../public/imagens/benefits/jogo_peca.png";
import nuvemCoracao from "../../public/imagens/benefits/nuvem_coracao.png";
import nuvems from "../../public/imagens/benefits/nuvems.png";

interface Props {
  campaignId: string;
}

const { campaignId } = Astro.props;
const [
  hero_sm,
  hero_md,
  hero_lg,
  hero_xl
] = await Promise.all([
  getImage({ src: criancasHero, format: "avif", width: 480,  quality: 50 }),
  getImage({ src: criancasHero, format: "avif", width: 768,  quality: 55 }),
  getImage({ src: criancasHero, format: "avif", width: 960,  quality: 60 }),
  getImage({ src: criancasHero, format: "avif", width: 1440, quality: 65 }),
]);

const heroSrcset = `
  ${hero_sm.src} 480w,
  ${hero_md.src} 768w,
  ${hero_lg.src} 960w,
  ${hero_xl.src} 1440w
`;
const heroSizes = "(max-width: 768px) 95vw, 55vw";

const benefits = [
  {
    icon: rostoFeliz,
    title: "A criança se reconhece",
    text: "Quando a criança ouve o próprio nome na música, os olhinhos brilham. Um momento de alegria que você vai querer registrar.",
  },
  {
    icon: globo,
    title: "Para quem está longe",
    text: "Uma cantiga com o nome do seu neto que você pode mandar agora pelo WhatsApp. A distância desaparece em minutos. ",
  },
  {
    icon: coracao,
    title: "Uma lembrança que fica para sempre",
    text: "Um dia essa criança vai crescer, ouvir essa cantiga… e lembrar do carinho de quem deu esse presente.",
  },
  {
    icon: nuvemCoracao,
    title: "Um presente diferente de tudo que você já comprou",
    text: "Brinquedo passa. Roupa deixa de servir. Esse presente não — ele vira memória, afeto e história de família.",
  },
  {
    icon: jogoPeca,
    title: "Aprender brincando",
    text: "Enquanto se diverte, a criança aprende a ouvir, esperar e prestar atenção.",
  },
  {
    icon: nuvems,
    title: "Estimula a fala naturalmente",
    text: "A música ajuda a criança a reconhecer sons, palavras e a se comunicar melhor. ",
  },
];

const year = new Date().getFullYear();
