    <!-- Coluna direita: espaço para o celular (mesmo flex-1) -->
    <div class="flex-1 hidden md:block"></div>
  </div>
</div>
        <!-- Faixa azul escura abaixo do azul claro -->
        <div class="w-full py-10" style="background: #00AEEF;"></div>

      </section>

      <!-- BENEFITS -->
      <section
