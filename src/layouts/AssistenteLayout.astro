---
import FooterInstitucional from '../components/FooterInstitucional.astro';
// [ASSISTENTE 2026-07] Layout mínimo do Assistente Guiado — mesmo PixelHead
// (Meta + TikTok, init imediato + fbevents após idle) e fontes do projeto.
import "../styles/global.css";
import PixelHead from "../components/PixelHead.astro";

interface Props { title?: string }
const { title = "Tião Camaleão · Cantigas Personalizadas" } = Astro.props;
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#12B3F2" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <title>{title}</title>
    <meta name="description" content="Ouça grátis uma cantiga com o nome da sua criança e monte os álbuns personalizados." />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Baloo+2:wght@500;600;700;800&family=Nunito:wght@400;600;700;800&display=swap" rel="stylesheet" />
    <PixelHead />
  </head>
  <body class="min-h-screen bg-[#12B3F2] font-sans antialiased">
    <main><slot /></main>
      <FooterInstitucional />
  </body>
</html>
