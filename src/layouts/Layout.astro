---
// src/layouts/Layout.astro
import "../styles/global.css";
import PixelHead from "../components/PixelHead.astro";

const TC_API_URL = import.meta.env.PUBLIC_API_URL ?? "";
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <title>{Astro.props.title || "Tião Camaleão – Cantigas personalizadas"}</title>
    <meta
      name="description"
      content={Astro.props.description || "Cantigas infantis personalizadas com o nome da sua criança. Mais de 2.000 nomes gravados em estúdio. Presente único que vira memória de família."}
    />
    <PixelHead />
    {Astro.props.slot}
  </head>
  <body>
    <div class="min-h-screen overflow-hidden bg-background">
      <slot />
    </div>
    <!-- WhatsApp floating button -->
    <style>
      @keyframes wa-ring {
        0%   { transform: scale(1); opacity: 0.55; }
        100% { transform: scale(2.4); opacity: 0; }
      }
      .wa-wrap { position: fixed; bottom: 20px; right: 20px; z-index: 9999; width: 60px; height: 60px; }
      .wa-ring {
        position: absolute; inset: 0;
        border-radius: 50%;
        background: #25D366;
        animation: wa-ring 2.4s ease-out infinite;
        pointer-events: none;
      }
      .wa-ring-2 { animation-delay: 1.2s; }
      .wa-btn {
        position: relative; z-index: 1;
        display: flex; align-items: center; justify-content: center;
        width: 60px; height: 60px;
        border-radius: 50%;
        background: #25D366;
        box-shadow: 0 4px 18px rgba(0,0,0,0.28);
        transition: transform 0.2s;
        text-decoration: none;
      }
      .wa-btn:hover { transform: scale(1.12); }
    </style>
    <div class="wa-wrap">
      <div class="wa-ring"></div>
      <div class="wa-ring wa-ring-2"></div>
      <a
        href="https://wa.me/message/2OACSAWR5D6LD1"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Falar no WhatsApp"
        class="wa-btn"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="white">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-4.821 4.754a8.132 8.132 0 01-3.984-1.03l-.286-.17-2.96.776.791-2.887-.186-.296a8.14 8.14 0 01-1.247-4.346c0-4.519 3.674-8.19 8.19-8.19a8.19 8.19 0 018.19 8.19c0 4.52-3.674 8.19-8.19 8.19m0-18.054C7.452 1.082 2.591 5.943 2.591 11.956c0 1.92.487 3.793 1.412 5.46L2.4 23l5.688-1.491a9.357 9.357 0 004.515 1.156c6.012 0 10.874-4.861 10.874-10.873 0-2.864-1.115-5.556-3.141-7.581C18.303 2.197 15.612 1.082 12.651 1.082z" />
        </svg>
      </a>
    </div>
  </body>
</html>